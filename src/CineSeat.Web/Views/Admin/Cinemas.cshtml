@model CineSeat.Web.Models.AdminCinemasViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Cụm Rạp & Phòng Chiếu";
}

<div class="pb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-extrabold text-white mb-1 d-flex align-items-center gap-2">
                <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-building"></i></span>
                Quản Lý Cụm Rạp & Phòng Chiếu
            </h3>
            <p class="text-secondary small mb-0">Quản lý các rạp CineSeat, hệ thống phòng chiếu và sơ đồ 40 ghế vật lý chuẩn</p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-2 d-flex align-items-center gap-1 shadow" data-bs-toggle="modal" data-bs-target="#addRoomModal">
                <i class="bi bi-door-open-fill"></i>
                <span>Thêm Phòng Chiếu</span>
            </button>
            <button type="button" class="btn btn-cinema btn-sm rounded-pill px-3 py-2 d-flex align-items-center gap-1 shadow" data-bs-toggle="modal" data-bs-target="#addCinemaModal">
                <i class="bi bi-plus-circle"></i>
                <span>Thêm Cụm Rạp</span>
            </button>
        </div>
    </div>

    <!-- DANH SÁCH CỤM RẠP -->
    <div class="row g-4 mb-5">
        @foreach (var c in Model.Cinemas)
        {
            var cinemaRooms = Model.Rooms.Where(r => r.CinemaId == c.CinemaId).ToList();
            <div class="col-lg-6">
                <div class="card bg-card border-cs rounded-4 p-4 shadow-sm h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="p-2 rounded-3 bg-danger bg-opacity-25 text-danger">
                                <i class="bi bi-geo-alt-fill fs-5"></i>
                            </span>
                            <div>
                                <h5 class="fw-bold text-white mb-0">@c.CinemaName</h5>
                                <small class="text-gold fs-9">Mã rạp: #@c.CinemaId &bull; @cinemaRooms.Count phòng chiếu</small>
                            </div>
                        </div>

                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-1 fs-9"
                                    onclick="openEditCinemaModal(@c.CinemaId, '@Html.Raw(Html.Encode(c.CinemaName))', '@Html.Raw(Html.Encode(c.Address))')">
                                <i class="bi bi-pencil-square me-1"></i>Sửa
                            </button>
                            <form asp-action="DeleteCinema" asp-route-id="@c.CinemaId" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa cụm rạp này? Chỉ có thể xóa nếu chưa có suất chiếu.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 fs-9">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <p class="text-secondary small mb-3">
                        <i class="bi bi-pin-map text-danger me-1"></i>@c.Address
                    </p>

                    <!-- Danh sách phòng chiếu của rạp này -->
                    <div class="border-top border-cs pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold fs-8 text-white">Phòng chiếu trực thuộc:</span>
                            <span class="badge bg-dark border-cs text-secondary fs-9">40 ghế / phòng</span>
                        </div>

                        @if (!cinemaRooms.Any())
                        {
                            <div class="text-secondary fs-9 fst-italic p-2 bg-surface rounded-2">
                                Chưa có phòng chiếu nào tại cụm rạp này.
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var r in cinemaRooms)
                                {
                                    <div class="p-2 bg-surface border-cs rounded-3 d-flex align-items-center justify-content-between" style="min-width: 140px;">
                                        <div>
                                            <div class="fw-semibold text-white fs-8"><i class="bi bi-door-closed text-gold me-1"></i>@r.RoomName</div>
                                            <small class="text-secondary fs-9">5 hàng (A-E) x 8 ghế</small>
                                        </div>
                                        <form asp-action="DeleteRoom" asp-route-id="@r.RoomId" method="post" class="d-inline ms-2"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa phòng chiếu @r.RoomName? Chỉ có thể xóa nếu chưa có suất chiếu.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa phòng chiếu">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- MODAL THÊM CỤM RẠP -->
<div class="modal fade" id="addCinemaModal" tabindex="-1" aria-labelledby="addCinemaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="addCinemaModalLabel">
                    <i class="bi bi-building text-danger"></i>Thêm Cụm Rạp Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCinema" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Tên Cụm Rạp: <span class="text-danger">*</span></label>
                        <input type="text" name="CinemaName" class="form-control bg-surface border-cs text-white shadow-none" required placeholder="VD: CineSeat Landmark 81" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Địa Chỉ Chi Tiết: <span class="text-danger">*</span></label>
                        <input type="text" name="Address" class="form-control bg-surface border-cs text-white shadow-none" required placeholder="VD: Tầng B1, Vincom Landmark 81, Bình Thạnh, TP.HCM" />
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4 fw-bold">Lưu Cụm Rạp</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL SỬA CỤM RẠP -->
<div class="modal fade" id="editCinemaModal" tabindex="-1" aria-labelledby="editCinemaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="editCinemaModalLabel">
                    <i class="bi bi-pencil-square text-info"></i>Sửa Thông Tin Cụm Rạp
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditCinema" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCinemaId" name="CinemaId" value="" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Tên Cụm Rạp: <span class="text-danger">*</span></label>
                        <input type="text" id="editCinemaName" name="CinemaName" class="form-control bg-surface border-cs text-white shadow-none" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Địa Chỉ Chi Tiết: <span class="text-danger">*</span></label>
                        <input type="text" id="editAddress" name="Address" class="form-control bg-surface border-cs text-white shadow-none" required />
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4 fw-bold">Cập Nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL THÊM PHÒNG CHIẾU -->
<div class="modal fade" id="addRoomModal" tabindex="-1" aria-labelledby="addRoomModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="addRoomModalLabel">
                    <i class="bi bi-door-open-fill text-warning"></i>Thêm Phòng Chiếu Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddRoom" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="alert alert-info bg-surface border-cs text-info fs-8 mb-3">
                        <i class="bi bi-info-circle me-1"></i>Hệ thống sẽ tự động khởi tạo 40 ghế vật lý (Hàng A, B, C ghế Standard và Hàng D, E ghế VIP).
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Chọn Cụm Rạp: <span class="text-danger">*</span></label>
                        <select name="CinemaId" class="form-select bg-surface border-cs text-white shadow-none" required>
                            @foreach (var c in Model.Cinemas)
                            {
                                <option value="@c.CinemaId">@c.CinemaName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Tên Phòng Chiếu: <span class="text-danger">*</span></label>
                        <input type="text" name="RoomName" class="form-control bg-surface border-cs text-white shadow-none" required placeholder="VD: Phòng Chiếu 3 (IMAX)" />
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4 fw-bold">Khởi Tạo Phòng & 40 Ghế</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditCinemaModal(id, name, address) {
        document.getElementById('editCinemaId').value = id;
        document.getElementById('editCinemaName').value = name;
        document.getElementById('editAddress').value = address;
        const modal = new bootstrap.Modal(document.getElementById('editCinemaModal'));
        modal.show();
    }
</script>
}
