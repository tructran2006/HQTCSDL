@model CineSeat.Web.Models.AdminBookingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Đơn Đặt Vé Toàn Hệ Thống";
}

<div class="pb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-extrabold text-white mb-1 d-flex align-items-center gap-2">
                <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-ticket-detailed-fill"></i></span>
                Quản Lý Đơn Đặt Vé Toàn Hệ Thống
            </h3>
            <p class="text-secondary small mb-0">Theo dõi và quản lý toàn bộ giao dịch đặt vé xem phim trong hệ thống</p>
        </div>

        <!-- Nút Quét Thu Hồi Ghế Quá Hạn -->
        <form asp-action="TriggerExpire" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path?status=@Model.StatusFilter" />
            <button type="submit" class="btn btn-cinema-gold btn-sm rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow">
                <i class="bi bi-hourglass-bottom"></i>
                <span>Quét & giải phóng ghế giữ quá hạn</span>
            </button>
        </form>
    </div>

    <!-- TABS LỌC THEO TRẠNG THÁI -->
    <div class="card bg-card border-cs rounded-4 p-3 mb-4 shadow-sm">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Bookings" asp-route-status="ALL" 
               class="btn @(Model.StatusFilter == "ALL" ? "btn-danger fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                Tất cả đơn (@Model.Bookings.Count)
            </a>
            <a asp-action="Bookings" asp-route-status="PAID" 
               class="btn @(Model.StatusFilter == "PAID" ? "btn-success fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                <i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán (PAID)
            </a>
            <a asp-action="Bookings" asp-route-status="HELD" 
               class="btn @(Model.StatusFilter == "HELD" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                <i class="bi bi-hourglass-split me-1"></i>Đang giữ ghế (HELD)
            </a>
            <a asp-action="Bookings" asp-route-status="CANCELLED" 
               class="btn @(Model.StatusFilter == "CANCELLED" ? "btn-secondary fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                <i class="bi bi-x-circle me-1"></i>Đã hủy (CANCELLED)
            </a>
            <a asp-action="Bookings" asp-route-status="EXPIRED" 
               class="btn @(Model.StatusFilter == "EXPIRED" ? "btn-danger fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                <i class="bi bi-exclamation-circle me-1"></i>Hết hạn (EXPIRED)
            </a>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH ĐƠN ĐẶT VÉ -->
    <div class="card bg-card border-cs rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-bordered border-cs align-middle mb-0 fs-8">
                <thead class="table-black border-cs text-secondary text-uppercase fs-9">
                    <tr>
                        <th style="width: 70px;">Mã Đơn</th>
                        <th>Khách Hàng (Tài Khoản)</th>
                        <th>Phim & Suất Chiếu</th>
                        <th style="width: 140px;">Cụm Rạp / Phòng</th>
                        <th style="width: 100px;">Số Ghế</th>
                        <th style="width: 120px;">Tổng Tiền</th>
                        <th style="width: 140px;">Trạng Thái</th>
                        <th style="width: 160px;">Thời Gian Đặt / Hết Hạn</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bookings.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-secondary">
                                Không có đơn đặt vé nào phù hợp với bộ lọc [@Model.StatusFilter].
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.Bookings)
                        {
                            <tr>
                                <td class="fw-bold text-white">#@b.BookingId</td>
                                <td>
                                    <div class="fw-semibold text-white">@b.FullName</div>
                                    <small class="text-secondary fs-9">@b.Email (ID: @b.UserId)</small>
                                </td>
                                <td>
                                    <div class="fw-bold text-white fs-7">@b.MovieTitle</div>
                                    <small class="text-gold fs-9">
                                        <i class="bi bi-clock me-1"></i>@b.StartAt?.ToString("HH:mm dd/MM/yyyy")
                                    </small>
                                </td>
                                <td>
                                    <div class="text-white">@b.CinemaName</div>
                                    <small class="text-info fs-9">@b.RoomName</small>
                                </td>
                                <td>
                                    <span class="badge bg-dark border-cs text-white fs-8">@b.SeatCount vé</span>
                                </td>
                                <td class="fw-bold text-gold fs-7">
                                    @b.TotalAmount.ToString("#,##0") ₫
                                </td>
                                <td>
                                    @if (b.Status == "PAID")
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                            <i class="bi bi-check-circle-fill me-1"></i>PAID
                                        </span>
                                    }
                                    else if (b.Status == "HELD")
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">
                                            <i class="bi bi-hourglass-split me-1"></i>HELD (Giữ 5p)
                                        </span>
                                    }
                                    else if (b.Status == "CANCELLED")
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50">
                                            <i class="bi bi-x-circle me-1"></i>CANCELLED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                            <i class="bi bi-exclamation-circle me-1"></i>EXPIRED
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="text-secondary fs-9">Đặt: @b.CreatedAt.ToString("HH:mm dd/MM")</div>
                                    @if (b.Status == "HELD")
                                    {
                                        <div class="text-warning fs-9 fw-semibold">Hết hạn: @b.ExpiresAt.ToString("HH:mm:ss")</div>
                                    }
                                    else if (b.PaidAt.HasValue)
                                    {
                                        <div class="text-success fs-9">Thanh toán: @b.PaidAt.Value.ToString("HH:mm")</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
