@model CineSeat.Web.Models.AdminMoviesViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Danh Mục Phim";
}

<div class="pb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-extrabold text-white mb-1 d-flex align-items-center gap-2">
                <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-film"></i></span>
                Quản Lý Danh Mục Phim
            </h3>
            <p class="text-secondary small mb-0">Danh sách phim được lưu trữ trực tiếp trong bảng <code>MOVIES</code> (Schema CINESEAT)</p>
        </div>

        <button type="button" class="btn btn-cinema btn-sm rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow" data-bs-toggle="modal" data-bs-target="#addMovieModal">
            <i class="bi bi-plus-circle"></i>
            <span>Thêm Phim Mới</span>
        </button>
    </div>

    <!-- Bảng danh sách phim -->
    <div class="card bg-card border-cs rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-bordered border-cs align-middle mb-0 fs-8">
                <thead class="table-black border-cs text-secondary text-uppercase fs-9">
                    <tr>
                        <th style="width: 60px;">Mã</th>
                        <th style="width: 80px;">Poster</th>
                        <th>Tên Phim & Thể Loại</th>
                        <th style="width: 100px;">Độ Tuổi</th>
                        <th style="width: 110px;">Thời Lượng</th>
                        <th style="width: 110px;">Suất Chiếu</th>
                        <th style="width: 130px;">Trạng Thái</th>
                        <th style="width: 140px;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Movies)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@m.MovieId</td>
                            <td>
                                <img src="/images/@(string.IsNullOrEmpty(m.PosterFile) ? "default-poster.jpg" : m.PosterFile)" 
                                     alt="@m.Title" class="rounded shadow" style="width: 50px; height: 75px; object-fit: cover;"
                                     onerror="this.onerror=null; this.src='/images/default-poster.jpg';" />
                            </td>
                            <td>
                                <div class="fw-bold text-white fs-7 mb-1">@m.Title</div>
                                <div class="text-gold fs-9"><i class="bi bi-tags me-1"></i>@m.Genre</div>
                                <small class="text-secondary fs-9 d-block text-truncate mt-1" style="max-width: 380px;">
                                    @m.Synopsis
                                </small>
                            </td>
                            <td>
                                <span class="badge badge-rating badge-rating-@m.AgeRating">@m.AgeRating</span>
                            </td>
                            <td class="text-white">
                                <i class="bi bi-clock me-1 text-danger"></i>@m.DurationMin phút
                            </td>
                            <td>
                                <span class="badge bg-dark border-cs text-info">@m.ShowtimeCount suất</span>
                            </td>
                            <td>
                                @if (m.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                        <i class="bi bi-check-circle me-1"></i>Đang Chiếu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50">
                                        <i class="bi bi-pause-circle me-1"></i>Tạm Ẩn
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleMovie" asp-route-id="@m.MovieId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(m.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3 py-1 fs-9">
                                        @(m.IsActive ? "Tắt Chiếu" : "Bật Chiếu")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM PHIM MỚI -->
<div class="modal fade" id="addMovieModal" tabindex="-1" aria-labelledby="addMovieModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="addMovieModalLabel">
                    <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-film"></i></span>
                    Thêm Bộ Phim Mới (INSERT INTO MOVIES)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddMovie" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fs-8 text-secondary fw-semibold">Tên Phim (Title):</label>
                            <input type="text" name="Title" class="form-control bg-surface border-cs text-white shadow-none" required placeholder="Nhập tên phim..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fs-8 text-secondary fw-semibold">Phân Loại Độ Tuổi (Age Rating):</label>
                            <select name="AgeRating" class="form-select bg-surface border-cs text-white shadow-none">
                                <option value="P">P - Mọi lứa tuổi</option>
                                <option value="K">K - Dưới 13 tuổi có người bảo trợ</option>
                                <option value="T13" selected>T13 - Từ 13 tuổi trở lên</option>
                                <option value="T16">T16 - Từ 16 tuổi trở lên</option>
                                <option value="T18">T18 - Từ 18 tuổi trở lên</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fs-8 text-secondary fw-semibold">Thể Loại (Genre):</label>
                            <input type="text" name="Genre" class="form-control bg-surface border-cs text-white shadow-none" required placeholder="VD: Hành động / Viễn tưởng" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-secondary fw-semibold">Thời Lượng (Phút):</label>
                            <input type="number" name="DurationMin" class="form-control bg-surface border-cs text-white shadow-none" required min="30" max="300" value="120" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fs-8 text-secondary fw-semibold">Tên File Poster:</label>
                            <input type="text" name="PosterFile" class="form-control bg-surface border-cs text-white shadow-none" value="default-poster.jpg" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fs-8 text-secondary fw-semibold">Tóm Tắt Nội Dung (Synopsis):</label>
                            <textarea name="Synopsis" rows="3" class="form-control bg-surface border-cs text-white shadow-none" placeholder="Nhập tóm tắt nội dung phim..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4">Lưu Phim Mới</button>
                </div>
            </form>
        </div>
    </div>
</div>
