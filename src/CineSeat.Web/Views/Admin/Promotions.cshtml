@model CineSeat.Web.Models.AdminPromotionsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Mã Khuyến Mãi";
}

<div class="pb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-extrabold text-white mb-1 d-flex align-items-center gap-2">
                <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-tag-fill"></i></span>
                Quản Lý Mã Khuyến Mãi (Promotions)
            </h3>
            <p class="text-secondary small mb-0">Quản lý các chương trình ưu đãi giảm giá vé xem phim tự động tính theo tỷ lệ phần trăm</p>
        </div>

        <button type="button" class="btn btn-cinema btn-sm rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow" data-bs-toggle="modal" data-bs-target="#addPromotionModal">
            <i class="bi bi-plus-circle"></i>
            <span>Thêm Mã Mới</span>
        </button>
    </div>

    <!-- Bảng danh sách mã khuyến mãi -->
    <div class="card bg-card border-cs rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-dark table-hover table-bordered border-cs align-middle mb-0 fs-8">
                <thead class="table-black border-cs text-secondary text-uppercase fs-9">
                    <tr>
                        <th style="width: 70px;">Mã ID</th>
                        <th>Mã Code Khuyến Mãi</th>
                        <th style="width: 140px;">Tỷ Lệ Giảm Giá</th>
                        <th style="width: 170px;">Hạn Sử Dụng</th>
                        <th style="width: 120px;">Đã Sử Dụng</th>
                        <th style="width: 130px;">Trạng Thái</th>
                        <th style="width: 160px;" class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Promotions)
                    {
                        bool isExpired = p.ValidUntil.Date < DateTime.Today;
                        <tr>
                            <td class="fw-bold text-secondary">#@p.PromotionId</td>
                            <td>
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 fs-7 px-3 py-1 fw-bold tracking-wider">
                                    @p.PromoCode
                                </span>
                            </td>
                            <td>
                                <span class="fs-6 fw-extrabold text-gold">-@p.DiscountPct%</span>
                            </td>
                            <td>
                                <div class="text-white fw-semibold">
                                    <i class="bi bi-calendar-event me-1 text-danger"></i>@p.ValidUntil.ToString("dd/MM/yyyy")
                                </div>
                                @if (isExpired)
                                {
                                    <small class="text-danger fs-9 fw-bold">Đã hết hạn</small>
                                }
                                else
                                {
                                    <small class="text-secondary fs-9">Còn hạn</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-dark border-cs text-info">@p.UsedCount đơn vé</span>
                            </td>
                            <td>
                                @if (isExpired)
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary">Hết Hạn</span>
                                }
                                else if (p.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                        <i class="bi bi-check-circle me-1"></i>Đang Áp Dụng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm Tắt</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <!-- Nút Sửa -->
                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-1 fs-9"
                                            onclick="openEditPromotionModal(@p.PromotionId, '@p.PromoCode', @p.DiscountPct, '@p.ValidUntil.ToString("yyyy-MM-dd")', @(p.IsActive ? "true" : "false"))">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </button>

                                    <!-- Nút Bật/Tắt -->
                                    <form asp-action="TogglePromotion" asp-route-id="@p.PromotionId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-2 py-1 fs-9">
                                            @(p.IsActive ? "Tắt" : "Bật")
                                        </button>
                                    </form>

                                    <!-- Nút Xóa -->
                                    <form asp-action="DeletePromotion" asp-route-id="@p.PromotionId" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã này? Nếu đã có đơn sử dụng, mã sẽ được tự động vô hiệu hóa.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 fs-9">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL THÊM MÃ KHUYẾN MÃI -->
<div class="modal fade" id="addPromotionModal" tabindex="-1" aria-labelledby="addPromotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="addPromotionModalLabel">
                    <i class="bi bi-tag-fill text-danger"></i>Thêm Mã Khuyến Mãi Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddPromotion" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Mã Khuyến Mãi (Viết hoa, không dấu): <span class="text-danger">*</span></label>
                        <input type="text" name="PromoCode" class="form-control bg-surface border-cs text-white text-uppercase shadow-none" required placeholder="VD: SUMMER2026" />
                        <small class="text-secondary fs-9">Chỉ gồm chữ cái và số, từ 3 đến 30 ký tự</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Tỷ Lệ Giảm Giá (% từ 1 đến 50): <span class="text-danger">*</span></label>
                        <input type="number" name="DiscountPct" class="form-control bg-surface border-cs text-white shadow-none" required min="1" max="50" step="0.5" value="10" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Ngày Hết Hạn Áp Dụng: <span class="text-danger">*</span></label>
                        <input type="date" name="ValidUntil" class="form-control bg-surface border-cs text-white shadow-none" required 
                               value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4 fw-bold">Lưu Mã Khuyến Mãi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL SỬA MÃ KHUYẾN MÃI -->
<div class="modal fade" id="editPromotionModal" tabindex="-1" aria-labelledby="editPromotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-card border-cs rounded-4 text-white">
            <div class="modal-header border-cs">
                <h5 class="modal-title fw-bold text-white d-flex align-items-center gap-2" id="editPromotionModalLabel">
                    <i class="bi bi-pencil-square text-info"></i>Sửa Mã Khuyến Mãi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EditPromotion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editPromoId" name="PromotionId" value="" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Mã Khuyến Mãi: <span class="text-danger">*</span></label>
                        <input type="text" id="editPromoCode" name="PromoCode" class="form-control bg-surface border-cs text-white text-uppercase shadow-none" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Tỷ Lệ Giảm Giá (% từ 1 đến 50): <span class="text-danger">*</span></label>
                        <input type="number" id="editDiscountPct" name="DiscountPct" class="form-control bg-surface border-cs text-white shadow-none" required min="1" max="50" step="0.5" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Ngày Hết Hạn: <span class="text-danger">*</span></label>
                        <input type="date" id="editValidUntil" name="ValidUntil" class="form-control bg-surface border-cs text-white shadow-none" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fs-8 text-secondary fw-semibold">Trạng Thái Áp Dụng:</label>
                        <select id="editIsActive" name="IsActive" class="form-select bg-surface border-cs text-white shadow-none">
                            <option value="true">Đang Áp Dụng (Bật)</option>
                            <option value="false">Tạm Ngưng (Tắt)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-cs">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-cinema rounded-pill px-4 fw-bold">Cập Nhật Mã</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditPromotionModal(id, code, pct, validUntil, isActive) {
        document.getElementById('editPromoId').value = id;
        document.getElementById('editPromoCode').value = code;
        document.getElementById('editDiscountPct').value = pct;
        document.getElementById('editValidUntil').value = validUntil;
        document.getElementById('editIsActive').value = isActive ? "true" : "false";

        const modal = new bootstrap.Modal(document.getElementById('editPromotionModal'));
        modal.show();
    }
</script>
}
