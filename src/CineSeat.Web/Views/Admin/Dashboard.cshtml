@model CineSeat.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Thống Kê & Nhật Ký Audit";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-speedometer2 text-warning"></i> Thống Kê Doanh Thu & Nhật Ký Audit
        </h3>
        <p class="text-secondary mb-0">
            Giám sát thời gian thực &bull; Tự động ghi nhận thông qua Trigger <code>TRG_BOOKING_AUDIT</code> trên Oracle Database 23ai
        </p>
    </div>

    <!-- Manual Trigger PR_EXPIRE_HOLDS Button -->
    <form asp-action="TriggerExpire" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-warning fw-semibold shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-arrow-clockwise"></i> Chạy Thu Hồi Ghế Quá Hạn (PR_EXPIRE_HOLDS)
        </button>
    </form>
</div>

<!-- Stats Metric Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-3 mb-4">
    <!-- Revenue -->
    <div class="col">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 text-uppercase fw-semibold">Tổng Doanh Thu</span>
                <span class="p-2 rounded-3 bg-success bg-opacity-10 text-success"><i class="bi bi-cash-coin fs-5"></i></span>
            </div>
            <div class="fs-4 fw-bold text-success mb-1">@Model.TotalRevenue.ToString("#,##0") ₫</div>
            <small class="text-secondary fs-9">Từ các đơn vé <strong>PAID</strong></small>
        </div>
    </div>

    <!-- Paid -->
    <div class="col">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 text-uppercase fw-semibold">Đã Thanh Toán</span>
                <span class="p-2 rounded-3 bg-success bg-opacity-10 text-success"><i class="bi bi-check2-circle fs-5"></i></span>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">@Model.PaidCount</div>
            <small class="text-secondary fs-9">Đơn hàng hoàn tất</small>
        </div>
    </div>

    <!-- Held -->
    <div class="col">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 text-uppercase fw-semibold">Đang Giữ Chỗ</span>
                <span class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning"><i class="bi bi-hourglass-split fs-5"></i></span>
            </div>
            <div class="fs-4 fw-bold text-warning mb-1">@Model.HeldCount</div>
            <small class="text-secondary fs-9">Trong hạn 5 phút</small>
        </div>
    </div>

    <!-- Cancelled -->
    <div class="col">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 text-uppercase fw-semibold">Đã Hủy Vé</span>
                <span class="p-2 rounded-3 bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle fs-5"></i></span>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">@Model.CancelledCount</div>
            <small class="text-secondary fs-9">Khách chủ động hủy</small>
        </div>
    </div>

    <!-- Expired -->
    <div class="col">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary fs-8 text-uppercase fw-semibold">Quá Hạn Giữ</span>
                <span class="p-2 rounded-3 bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-clock-history fs-5"></i></span>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">@Model.ExpiredCount</div>
            <small class="text-secondary fs-9">Hết hạn &gt; 5 phút</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Audit Trail Section -->
    <div class="col-lg-7">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-shaded text-warning"></i> Nhật Ký Audit (BOOKING_AUDIT)
                </h5>
                <span class="badge bg-secondary fs-9">30 bản ghi mới nhất</span>
            </div>

            @if (Model.RecentAudits != null && Model.RecentAudits.Any())
            {
                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-dark table-sm table-hover align-middle mb-0 fs-8">
                        <thead class="border-secondary text-secondary text-uppercase fs-9 sticky-top bg-black">
                            <tr>
                                <th>Audit ID</th>
                                <th>Đơn #</th>
                                <th>Trạng Thái Cũ</th>
                                <th>Trạng Thái Mới</th>
                                <th>Thời Gian</th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.RecentAudits)
                            {
                                <tr>
                                    <td class="text-secondary font-monospace">@a.AuditId</td>
                                    <td class="fw-bold text-warning">#@a.BookingId</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(a.OldStatus))
                                        {
                                            <span class="text-secondary fst-italic">NULL (Tạo mới)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@a.OldStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (a.NewStatus == "PAID")
                                        {
                                            <span class="badge bg-success">PAID</span>
                                        }
                                        else if (a.NewStatus == "HELD")
                                        {
                                            <span class="badge bg-warning text-dark">HELD</span>
                                        }
                                        else if (a.NewStatus == "CANCELLED")
                                        {
                                            <span class="badge bg-danger">CANCELLED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@a.NewStatus</span>
                                        }
                                    </td>
                                    <td class="text-secondary">@a.ChangedAt.ToString("HH:mm:ss dd/MM/yy")</td>
                                    <td class="text-light">@a.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="py-5 text-center text-secondary">
                    <i class="bi bi-journal-x fs-1 d-block mb-2 opacity-25"></i>
                    <span>Chưa có dữ liệu nhật ký trong bảng BOOKING_AUDIT.</span>
                </div>
            }
        </div>
    </div>

    <!-- Recent Bookings Section -->
    <div class="col-lg-5">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-warning"></i> Đơn Đặt Gần Đây
                </h5>
                <span class="badge bg-secondary fs-9">10 đơn mới nhất</span>
            </div>

            @if (Model.RecentBookings != null && Model.RecentBookings.Any())
            {
                <div class="d-flex flex-column gap-2" style="max-height: 480px; overflow-y: auto;">
                    @foreach (var b in Model.RecentBookings)
                    {
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-warning">Đơn #@b.BookingId</span>
                                @if (b.Status == "PAID")
                                {
                                    <span class="badge bg-success fs-9">PAID</span>
                                }
                                else if (b.Status == "HELD")
                                {
                                    <span class="badge bg-warning text-dark fs-9">HELD</span>
                                }
                                else if (b.Status == "CANCELLED")
                                {
                                    <span class="badge bg-danger fs-9">CANCELLED</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-9">EXPIRED</span>
                                }
                            </div>
                            <div class="fw-semibold text-white fs-8 text-truncate">@b.MovieTitle</div>
                            <div class="d-flex justify-content-between align-items-center text-secondary fs-9 mt-1">
                                <span>Khách: @b.FullName</span>
                                <span class="fw-bold text-light">@b.TotalAmount.ToString("#,##0") ₫</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-5 text-center text-secondary">
                    <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                    <span>Chưa có đơn đặt vé nào.</span>
                </div>
            }
        </div>
    </div>
</div>
