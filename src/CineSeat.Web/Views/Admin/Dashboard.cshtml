@model CineSeat.Web.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tổng Quan Dashboard & Kiểm Toán";
}

<div class="pb-5">
    <!-- Header Page -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-extrabold text-white mb-1 d-flex align-items-center gap-2">
                <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-speedometer2"></i></span>
                Dashboard Quản Trị Hệ Thống
            </h3>
            <p class="text-secondary small mb-0">Dữ liệu thời gian thực được tổng hợp 100% từ schema CINESEAT trong Oracle 23ai Free</p>
        </div>

        <form asp-action="TriggerExpire" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-cinema-gold btn-sm rounded-pill px-4 py-2 d-flex align-items-center gap-2 shadow">
                <i class="bi bi-hourglass-bottom"></i>
                <span>Chạy Quét Ghế Quá Hạn (PR_EXPIRE_HOLDS)</span>
            </button>
        </form>
    </div>

    <!-- 4 THẺ KPI TỔNG HỢP TỪ CSDL -->
    <div class="row g-4 mb-4">
        <!-- KPI 1: Tổng doanh thu vé PAID -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card kpi-revenue shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <small class="text-secondary text-uppercase fs-9 fw-bold">Tổng Doanh Thu (PAID)</small>
                    <span class="p-2 rounded-3 bg-danger bg-opacity-25 text-danger">
                        <i class="bi bi-cash-stack fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-extrabold text-white mb-1">@Model.TotalRevenue.ToString("#,##0") ₫</h3>
                <small class="text-success fs-9 d-flex align-items-center gap-1">
                    <i class="bi bi-check-circle-fill"></i> Từ @Model.PaidCount đơn đặt vé đã thanh toán
                </small>
            </div>
        </div>

        <!-- KPI 2: Tổng số vé đã bán -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card kpi-tickets shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <small class="text-secondary text-uppercase fs-9 fw-bold">Vé Đã Bán (SOLD)</small>
                    <span class="p-2 rounded-3 bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-ticket-perforated-fill fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-extrabold text-gold mb-1">@Model.TotalTicketsSold vé</h3>
                <small class="text-secondary fs-9 d-flex align-items-center gap-1">
                    <i class="bi bi-grid-3x3 me-1"></i> Trạng thái SOLD trong SHOWTIME_SEATS
                </small>
            </div>
        </div>

        <!-- KPI 3: Số đơn đang giữ chỗ -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card kpi-holds shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <small class="text-secondary text-uppercase fs-9 fw-bold">Đơn Đang Giữ Chỗ (HELD)</small>
                    <span class="p-2 rounded-3 bg-warning bg-opacity-25 text-warning">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-extrabold text-warning mb-1">@Model.HeldCount đơn</h3>
                <small class="text-secondary fs-9 d-flex align-items-center gap-1">
                    <i class="bi bi-clock me-1"></i> Tự động giải phóng sau 5 phút
                </small>
            </div>
        </div>

        <!-- KPI 4: Phim & Suất chiếu hoạt động -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card kpi-movies shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <small class="text-secondary text-uppercase fs-9 fw-bold">Phim & Suất Hoạt Động</small>
                    <span class="p-2 rounded-3 bg-success bg-opacity-25 text-success">
                        <i class="bi bi-film fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-extrabold text-white mb-1">@Model.ActiveMoviesCount phim</h3>
                <small class="text-info fs-9 d-flex align-items-center gap-1">
                    <i class="bi bi-calendar3 me-1"></i> @Model.ActiveShowtimesCount suất chiếu sắp tới
                </small>
            </div>
        </div>
    </div>

    <!-- 2 BIỂU ĐỒ TRỰC QUAN (CHART.JS) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ 1: Doanh thu theo phim (Bar Chart) -->
        <div class="col-lg-8">
            <div class="card bg-card border-cs rounded-4 p-4 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-bar-chart-fill text-danger"></i>
                        Doanh Thu Theo Từng Phim (VNĐ)
                    </h5>
                    <small class="text-secondary fs-9">Dữ liệu từ BOOKINGS & SHOWTIMES</small>
                </div>
                <div style="position: relative; height: 320px;">
                    <canvas id="movieRevenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 2: Tỷ lệ trạng thái đơn hàng (Doughnut Chart) -->
        <div class="col-lg-4">
            <div class="card bg-card border-cs rounded-4 p-4 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-pie-chart-fill text-gold"></i>
                        Trạng Thái Đơn Hàng
                    </h5>
                    <span class="badge bg-dark border-cs text-white fs-9">@Model.TotalBookings đơn</span>
                </div>
                <div style="position: relative; height: 260px;">
                    <canvas id="bookingStatusChart"></canvas>
                </div>
                <div class="d-flex justify-content-center gap-3 fs-9 text-secondary pt-3 border-top border-cs mt-3">
                    <div><span class="badge bg-success me-1">●</span>PAID: @Model.PaidCount</div>
                    <div><span class="badge bg-warning text-dark me-1">●</span>HELD: @Model.HeldCount</div>
                    <div><span class="badge bg-secondary me-1">●</span>CANCELLED: @Model.CancelledCount</div>
                    <div><span class="badge bg-danger me-1">●</span>EXPIRED: @Model.ExpiredCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG NHẬT KÝ KIỂM TOÁN HỆ THỐNG (BOOKING_AUDIT DO TRIGGER GHI) -->
    <div class="card bg-card border-cs rounded-4 p-4 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <span class="p-1 rounded-2 bg-warning bg-opacity-25 text-warning"><i class="bi bi-journal-code"></i></span>
                    Nhật Ký Kiểm Toán Trạng Thái (Bảng BOOKING_AUDIT)
                </h5>
                <p class="text-secondary fs-9 mb-0">
                    Ghi tự động bởi Trigger <code>TRG_BOOKING_AUDIT</code> mỗi khi có thao tác INSERT hoặc UPDATE trạng thái trên bảng <code>BOOKINGS</code>
                </p>
            </div>
            <span class="badge bg-dark border-cs text-gold fs-9">20 bản ghi mới nhất</span>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover table-bordered border-cs align-middle mb-0 fs-8">
                <thead class="table-black border-cs text-secondary text-uppercase fs-9">
                    <tr>
                        <th style="width: 70px;">Mã Audit</th>
                        <th style="width: 80px;">Mã Đơn</th>
                        <th>Khách Hàng / Phim</th>
                        <th style="width: 130px;">Trạng Thái Cũ</th>
                        <th style="width: 140px;">Trạng Thái Mới</th>
                        <th>Mô Tả Nghiệp Vụ</th>
                        <th style="width: 160px;">Thời Điểm (Timestamp)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentAudits.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-secondary">
                                Chưa có bản ghi nhật ký kiểm toán nào trong bảng BOOKING_AUDIT.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var audit in Model.RecentAudits)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#@audit.AuditId</td>
                                <td class="fw-bold text-white">#@audit.BookingId</td>
                                <td>
                                    <div class="fw-semibold text-white">@(string.IsNullOrEmpty(audit.CustomerName) ? "Hệ thống" : audit.CustomerName)</div>
                                    <small class="text-secondary fs-9">@(string.IsNullOrEmpty(audit.MovieTitle) ? "Đơn #" + audit.BookingId : audit.MovieTitle)</small>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(audit.OldStatus))
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50">
                                            (Khởi tạo mới)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark border-cs text-light">@audit.OldStatus</span>
                                    }
                                </td>
                                <td>
                                    @if (audit.NewStatus == "PAID")
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">
                                            <i class="bi bi-check-circle-fill me-1"></i>PAID
                                        </span>
                                    }
                                    else if (audit.NewStatus == "HELD")
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">
                                            <i class="bi bi-hourglass-split me-1"></i>HELD
                                        </span>
                                    }
                                    else if (audit.NewStatus == "CANCELLED")
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50">
                                            <i class="bi bi-x-circle me-1"></i>CANCELLED
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50">
                                            <i class="bi bi-exclamation-circle me-1"></i>@audit.NewStatus
                                        </span>
                                    }
                                </td>
                                <td class="text-secondary">@audit.Description</td>
                                <td class="text-secondary font-monospace fs-9">
                                    @audit.ChangedAt.ToString("yyyy-MM-dd HH:mm:ss.fff")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Biểu đồ Bar Chart: Doanh thu theo phim
        const movieTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MovieRevenues.Select(m => m.MovieTitle)));
        const movieRevenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MovieRevenues.Select(m => m.Revenue)));

        const ctxMovie = document.getElementById("movieRevenueChart").getContext("2d");
        new Chart(ctxMovie, {
            type: "bar",
            data: {
                labels: movieTitles,
                datasets: [{
                    label: "Doanh thu (VNĐ)",
                    data: movieRevenues,
                    backgroundColor: "rgba(229, 9, 20, 0.75)",
                    borderColor: "#E50914",
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: "#9CA3AF", font: { size: 11 } },
                        grid: { color: "rgba(255, 255, 255, 0.05)" }
                    },
                    y: {
                        ticks: {
                            color: "#9CA3AF",
                            callback: function(val) { return val.toLocaleString() + ' đ'; }
                        },
                        grid: { color: "rgba(255, 255, 255, 0.05)" }
                    }
                }
            }
        });

        // 2. Biểu đồ Doughnut Chart: Tỷ lệ trạng thái đơn
        const ctxStatus = document.getElementById("bookingStatusChart").getContext("2d");
        new Chart(ctxStatus, {
            type: "doughnut",
            data: {
                labels: ["Đã thanh toán (PAID)", "Đang giữ chỗ (HELD)", "Đã hủy (CANCELLED)", "Hết hạn (EXPIRED)"],
                datasets: [{
                    data: [@Model.PaidCount, @Model.HeldCount, @Model.CancelledCount, @Model.ExpiredCount],
                    backgroundColor: ["#10B981", "#F59E0B", "#6B7280", "#EF4444"],
                    borderColor: "#1A1D2B",
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                cutout: "65%"
            }
        });
    });
</script>
}
