@model List<CineSeat.Web.Models.Movie>
@{
    ViewData["Title"] = "Phim Đang Chiếu";
    var currentUser = ViewBag.CurrentUser as CineSeat.Web.Models.AppUser;
    var currentGenre = ViewBag.Genre as string;
    var currentSearch = ViewBag.Search as string;
    var genres = ViewBag.Genres as List<string> ?? new List<string>();
}

<!-- Hero Section -->
<div class="p-4 p-md-5 mb-4 rounded-4 bg-gradient position-relative overflow-hidden" 
     style="background: linear-gradient(135deg, #1f2937 0%, #111827 50%, #030712 100%); border: 1px solid rgba(255,255,255,0.08);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 text-uppercase">
                <i class="bi bi-stars me-1"></i> Rạp Chiếu Phim Đẳng Cấp 2026
            </span>
            <h1 class="display-5 fw-extrabold text-white mb-2">
                Trải Nghiệm Điện Ảnh Tuyệt Đỉnh Tại <span class="text-warning">CineSeat</span>
            </h1>
            <p class="lead text-secondary mb-4">
                Hệ thống đặt vé chuẩn 3NF trên nền tảng <strong>Oracle Database 23ai Free</strong> & <strong>ASP.NET Core (.NET 8)</strong>. 
                Giữ ghế thông minh, chống bán trùng vé bằng giao dịch PL/SQL và hàng đợi tranh chấp độc quyền.
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-dark border border-secondary px-3 py-2">
                    <i class="bi bi-person-check text-warning me-1"></i> Đang đăng nhập: <strong>@(currentUser?.FullName ?? "Demo User")</strong>
                </span>
                <span class="badge bg-dark border border-secondary px-3 py-2 text-info">
                    <i class="bi bi-clock-history me-1"></i> Giữ chỗ tự động 5 phút
                </span>
                <span class="badge bg-dark border border-secondary px-3 py-2 text-success">
                    <i class="bi bi-shield-lock me-1"></i> Khóa SELECT FOR UPDATE
                </span>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <div class="p-4 rounded-circle d-inline-block bg-warning bg-opacity-10 border border-warning border-opacity-25 shadow-lg">
                <i class="bi bi-ticket-perforated-fill text-warning" style="font-size: 6rem;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card bg-dark border-secondary border-opacity-25 mb-4 p-3 shadow-sm">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-black border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@currentSearch" class="form-control bg-black border-secondary text-light" placeholder="Tìm tên phim hoặc nội dung tóm tắt..." />
            </div>
        </div>
        <div class="col-md-5">
            <select name="genre" class="form-select bg-black border-secondary text-light">
                <option value="">-- Tất cả thể loại phim --</option>
                @foreach (var g in genres)
                {
                    <option value="@g" selected="@(g == currentGenre)">@g</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-warning fw-semibold flex-grow-1">
                <i class="bi bi-funnel me-1"></i> Lọc
            </button>
            @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentGenre))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </form>
</div>

<!-- Movies Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var movie in Model)
        {
            <div class="col">
                <div class="card h-100 movie-card rounded-4 overflow-hidden border-0">
                    <div class="movie-poster-wrapper position-relative">
                        <!-- Poster Image or Styled Fallback Banner -->
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3 text-center"
                             style="background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);">
                            <i class="bi bi-film text-warning opacity-50 mb-2" style="font-size: 3rem;"></i>
                            <h6 class="fw-bold text-white px-2 mb-1">@movie.Title</h6>
                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 fs-8">
                                @movie.Genre
                            </span>
                        </div>
                        
                        <!-- Age Rating Badge -->
                        <span class="movie-rating-badge @(movie.AgeRating == "T18" ? "bg-danger" : movie.AgeRating == "T16" ? "bg-warning text-dark" : movie.AgeRating == "T13" ? "bg-info text-dark" : "bg-success")">
                            @movie.AgeRating
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <h5 class="card-title fw-bold text-white text-truncate mb-1" title="@movie.Title">
                            @movie.Title
                        </h5>
                        <div class="d-flex align-items-center gap-2 text-secondary fs-8 mb-2">
                            <span><i class="bi bi-clock me-1"></i>@movie.DurationMin phút</span>
                            <span>&bull;</span>
                            <span class="text-truncate">@movie.Genre</span>
                        </div>
                        <p class="card-text text-secondary fs-8 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(movie.Synopsis) ? "Đang cập nhật nội dung tóm tắt..." : movie.Synopsis)
                        </p>
                        <a asp-action="Showtimes" asp-route-id="@movie.MovieId" class="btn btn-warning w-100 fw-bold mt-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-calendar-event"></i> Xem Lịch Chiếu
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 py-5 text-center text-secondary">
            <i class="bi bi-camera-reels fs-1 d-block mb-3 opacity-25"></i>
            <h5>Không tìm thấy bộ phim nào phù hợp với điều kiện tìm kiếm.</h5>
            <p>Vui lòng thử lại với từ khóa hoặc thể loại khác.</p>
            <a asp-action="Index" class="btn btn-outline-warning mt-2">Xem Tất Cả Phim</a>
        </div>
    }
</div>
