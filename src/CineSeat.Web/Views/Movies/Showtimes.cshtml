@model List<CineSeat.Web.Models.Showtime>
@{
    var movie = ViewBag.Movie as CineSeat.Web.Models.Movie ?? new CineSeat.Web.Models.Movie();
    ViewData["Title"] = $"Lịch Chiếu - {movie.Title}";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-warning text-decoration-none"><i class="bi bi-house me-1"></i> Trang Chủ</a></li>
        <li class="breadcrumb-item text-light">Lịch Chiếu</li>
        <li class="breadcrumb-item active text-secondary" aria-current="page">@movie.Title</li>
    </ol>
</nav>

<!-- Movie Header -->
<div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 mb-4 shadow">
    <div class="row align-items-center g-4">
        <div class="col-md-3 col-lg-2 text-center">
            <div class="rounded-3 p-4 bg-gradient d-flex flex-column align-items-center justify-content-center"
                 style="background: linear-gradient(135deg, #1e293b, #0f172a); min-height: 180px;">
                <i class="bi bi-film text-warning fs-1 mb-2"></i>
                <span class="badge @(movie.AgeRating == "T18" ? "bg-danger" : movie.AgeRating == "T16" ? "bg-warning text-dark" : "bg-success")">
                    Độ tuổi: @movie.AgeRating
                </span>
            </div>
        </div>
        <div class="col-md-9 col-lg-10">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">@movie.Genre</span>
                <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>@movie.DurationMin phút</span>
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50">Đang Chiếu</span>
            </div>
            <h2 class="fw-bold text-white mb-2">@movie.Title</h2>
            <p class="text-secondary mb-0">@(string.IsNullOrWhiteSpace(movie.Synopsis) ? "Đang cập nhật nội dung phim..." : movie.Synopsis)</p>
        </div>
    </div>
</div>

<!-- Showtimes List -->
<div class="mb-4 d-flex align-items-center justify-content-between">
    <h4 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-calendar2-week text-warning"></i> Các Suất Chiếu Khả Dụng
    </h4>
    <small class="text-secondary">Dữ liệu thời gian thực từ View <code>V_SHOWTIME_CATALOG</code></small>
</div>

@if (Model != null && Model.Any())
{
    <!-- Group by Cinema -->
    var groupedByCinema = Model.GroupBy(s => s.CinemaName).ToList();
    <div class="row g-4">
        @foreach (var cinemaGroup in groupedByCinema)
        {
            <div class="col-12">
                <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                        <div>
                            <h5 class="fw-bold text-white mb-0">@cinemaGroup.Key</h5>
                            <small class="text-secondary">@cinemaGroup.First().Address</small>
                        </div>
                    </div>

                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                        @foreach (var s in cinemaGroup)
                        {
                            <div class="col">
                                <div class="card bg-black border-secondary border-opacity-50 rounded-3 p-3 h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="badge bg-secondary text-uppercase fs-8"><i class="bi bi-door-open me-1"></i>@s.RoomName</span>
                                            <span class="badge @(s.AvailableSeats > 10 ? "bg-success bg-opacity-25 text-success border border-success border-opacity-50" : s.AvailableSeats > 0 ? "bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50" : "bg-danger")">
                                                <i class="bi bi-person-fill me-1"></i>Còn @s.AvailableSeats ghế trống
                                            </span>
                                        </div>
                                        <div class="fs-4 fw-bold text-warning mb-1">
                                            @s.StartAt.ToString("HH:mm") <span class="text-secondary fs-7 fw-normal">đến @s.EndAt.ToString("HH:mm")</span>
                                        </div>
                                        <div class="text-secondary fs-8 mb-3">
                                            <i class="bi bi-calendar3 me-1"></i>@s.StartAt.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between text-secondary fs-8">
                                            <span>Giá vé cơ bản:</span>
                                            <span class="fw-bold text-white">@s.BasePrice.ToString("#,##0") ₫</span>
                                        </div>
                                    </div>

                                    <div class="mt-3">
                                        @if (s.AvailableSeats > 0)
                                        {
                                            <a asp-controller="Bookings" asp-action="SelectSeats" asp-route-id="@s.ShowtimeId" 
                                               class="btn btn-warning w-100 fw-bold d-flex align-items-center justify-content-center gap-2">
                                                <i class="bi bi-grid-3x3-gap-fill"></i> Chọn Ghế & Đặt Vé
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary w-100 fw-semibold" disabled>
                                                <i class="bi bi-x-circle me-1"></i> Đã Hết Ghế
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-5 text-center text-secondary">
        <i class="bi bi-calendar-x fs-1 d-block mb-3 opacity-25"></i>
        <h5>Hiện tại chưa có suất chiếu tương lai nào cho bộ phim này.</h5>
        <p>Vui lòng quay lại sau hoặc chọn phim khác đang có lịch chiếu.</p>
        <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-warning mt-2">Xem Phim Khác</a>
    </div>
}
