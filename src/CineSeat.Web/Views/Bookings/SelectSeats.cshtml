@model CineSeat.Web.Models.SeatMapViewModel
@{
    ViewData["Title"] = $"Chọn Ghế - {modelTitle(Model)}";
    string modelTitle(CineSeat.Web.Models.SeatMapViewModel m) => m.Movie.Title;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-warning text-decoration-none">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Showtimes" asp-route-id="@Model.Showtime.MovieId" class="text-warning text-decoration-none">@Model.Movie.Title</a></li>
        <li class="breadcrumb-item active text-secondary" aria-current="page">Chọn Ghế Suất @Model.Showtime.StartAt.ToString("HH:mm")</li>
    </ol>
</nav>

<!-- Showtime Header Card -->
<div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 mb-4 shadow-sm">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">@Model.Movie.Genre</span>
                <span class="badge bg-secondary">@Model.Showtime.RoomName</span>
                <span class="badge bg-dark border border-secondary text-info">@Model.Showtime.CinemaName</span>
            </div>
            <h3 class="fw-bold text-white mb-1">@Model.Movie.Title</h3>
            <div class="text-secondary fs-8">
                <i class="bi bi-clock me-1"></i>@Model.Showtime.StartAt.ToString("HH:mm") - @Model.Showtime.EndAt.ToString("HH:mm") &bull; 
                <i class="bi bi-calendar3 me-1"></i>@Model.Showtime.StartAt.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            </div>
        </div>
        <div class="text-md-end">
            <div class="small text-secondary">Giá vé cơ bản</div>
            <div class="fs-4 fw-bold text-warning">@Model.Showtime.BasePrice.ToString("#,##0") ₫</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Seat Grid Section -->
    <div class="col-lg-8">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 shadow-sm">
            <!-- Screen Representation -->
            <div class="cinema-screen-container mb-5 text-center">
                <div class="cinema-screen mx-auto" style="max-width: 540px;"></div>
                <div class="cinema-screen-label"><i class="bi bi-display me-1"></i> MÀN HÌNH CHIẾU</div>
            </div>

            <!-- Seat Matrix -->
            <div class="d-flex flex-column gap-2 align-items-center justify-content-center mb-4">
                @foreach (var row in Model.Rows)
                {
                    <div class="d-flex align-items-center gap-2">
                        <!-- Row Label -->
                        <div class="text-secondary fw-bold fs-7" style="width: 24px; text-align: center;">@row.Key</div>

                        <!-- Seats in Row -->
                        <div class="d-flex gap-2">
                            @foreach (var seat in row.Value)
                            {
                                string seatClass = "seat-btn ";
                                bool isSelectable = seat.Status == "AVAILABLE";

                                if (seat.Status == "SOLD")
                                {
                                    seatClass += "seat-sold";
                                }
                                else if (seat.Status == "HELD")
                                {
                                    seatClass += "seat-held";
                                }
                                else
                                {
                                    seatClass += seat.SeatType == "VIP" ? "seat-available seat-vip" : "seat-available seat-standard";
                                }

                                <button type="button" 
                                        class="@seatClass" 
                                        data-seat-id="@seat.SeatId" 
                                        data-seat-code="@seat.SeatCode"
                                        data-seat-type="@seat.SeatType"
                                        data-status="@seat.Status"
                                        title="@seat.SeatCode (@seat.SeatType - @seat.Status)"
                                        @(isSelectable ? "" : "disabled")>
                                    @seat.SeatNumber
                                </button>
                            }
                        </div>

                        <!-- Row Label right -->
                        <div class="text-secondary fw-bold fs-7" style="width: 24px; text-align: center;">@row.Key</div>
                    </div>
                }
            </div>

            <!-- Legend -->
            <div class="d-flex flex-wrap justify-content-center gap-4 pt-3 border-top border-secondary border-opacity-25 fs-8 text-secondary">
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-btn seat-available seat-standard" style="width:24px; height:24px; font-size:10px;">1</span>
                    <span>Ghế thường</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-btn seat-available seat-vip" style="width:24px; height:24px; font-size:10px;">1</span>
                    <span>Ghế VIP</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-btn seat-selected" style="width:24px; height:24px; font-size:10px;">1</span>
                    <span>Đang chọn</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-btn seat-held" style="width:24px; height:24px; font-size:10px;">1</span>
                    <span>Đang giữ (HELD)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="seat-btn seat-sold" style="width:24px; height:24px; font-size:10px;">1</span>
                    <span>Đã bán (SOLD)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Booking Summary & Hold Panel -->
    <div class="col-lg-4">
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 shadow-sm sticky-top" style="top: 80px;">
            <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-receipt-cutoff text-warning"></i> Thông Tin Đặt Vé
            </h5>

            <div class="mb-3">
                <div class="small text-secondary mb-1">Ghế đã chọn (<span id="seatCountText">0</span>/8):</div>
                <div id="selectedSeatsContainer" class="d-flex flex-wrap gap-1 min-vh-25">
                    <span class="text-secondary fs-8 fst-italic">Chưa có ghế nào được chọn.</span>
                </div>
            </div>

            <!-- Promo Code Input -->
            <div class="mb-3">
                <label class="form-label fs-8 text-secondary">Mã khuyến mãi (Promotions):</label>
                <div class="input-group input-group-sm mb-1">
                    <input type="text" id="promoCodeInput" class="form-control bg-dark border-secondary text-light text-uppercase" placeholder="Nhập mã (VD: SALE10)" />
                    <button type="button" id="applyPromoBtn" class="btn btn-outline-warning">Áp dụng</button>
                </div>
                <div id="promoFeedback" class="fs-8 mt-1"></div>
                <!-- Suggested Codes -->
                <div class="mt-2">
                    <small class="text-secondary fs-9 d-block mb-1">Mã có sẵn:</small>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var p in Model.AvailablePromotions)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 fs-9 promo-tag" data-code="@p.PromoCode">
                                @p.PromoCode (-@p.DiscountPct%)
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Price Breakdown -->
            <div class="p-3 bg-dark rounded-3 border border-secondary border-opacity-25 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                    <span>Đơn giá cơ bản:</span>
                    <span>@Model.Showtime.BasePrice.ToString("#,##0") ₫ / ghế</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                    <span>Khung giờ:</span>
                    <span>@(Model.Showtime.StartAt.Hour >= 18 ? "+20% Giờ tối" : "Chuẩn")</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                    <span>Ngày chiếu:</span>
                    <span>@((Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Saturday || Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Sunday) ? "+10% Cuối tuần" : "Ngày thường")</span>
                </div>
                <hr class="border-secondary border-opacity-50 my-2" />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-white">Tạm tính (PL/SQL):</span>
                    <span id="totalPriceText" class="fs-4 fw-bold text-warning">0 ₫</span>
                </div>
            </div>

            <!-- Hold Form -->
            <form id="holdSeatsForm" asp-controller="Bookings" asp-action="Hold" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ShowtimeId" value="@Model.Showtime.ShowtimeId" />
                <input type="hidden" id="seatIdsJsonInput" name="SeatIdsJson" value="[]" />
                <input type="hidden" id="promoCodeFormInput" name="PromoCode" value="" />

                <button type="submit" id="submitHoldBtn" class="btn btn-warning w-100 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2" disabled>
                    <i class="bi bi-lock-fill"></i> Tiến Hành Giữ Ghế (5 Phút)
                </button>
            </form>

            <div class="text-center mt-2">
                <small class="text-secondary fs-9">
                    <i class="bi bi-info-circle me-1"></i> Gọi thủ tục <code>PKG_BOOKING.PR_HOLD</code> & giữ 5 phút.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectedSeats = new Map(); // seatId -> { code, type }
        const maxSeats = 8;
        const showtimeId = @Model.Showtime.ShowtimeId;

        const seatBtns = document.querySelectorAll(".seat-available");
        const container = document.getElementById("selectedSeatsContainer");
        const countText = document.getElementById("seatCountText");
        const priceText = document.getElementById("totalPriceText");
        const submitBtn = document.getElementById("submitHoldBtn");
        const seatJsonInput = document.getElementById("seatIdsJsonInput");
        const promoInput = document.getElementById("promoCodeInput");
        const promoFormInput = document.getElementById("promoCodeFormInput");
        const applyPromoBtn = document.getElementById("applyPromoBtn");
        const promoFeedback = document.getElementById("promoFeedback");

        // Click seat button
        seatBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const seatId = parseInt(this.getAttribute("data-seat-id"));
                const seatCode = this.getAttribute("data-seat-code");
                const seatType = this.getAttribute("data-seat-type");

                if (selectedSeats.has(seatId)) {
                    selectedSeats.delete(seatId);
                    this.classList.remove("seat-selected");
                } else {
                    if (selectedSeats.size >= maxSeats) {
                        alert("Mỗi đơn hàng chỉ được phép chọn tối đa 8 ghế (theo quy tắc ORA-20001)!");
                        return;
                    }
                    selectedSeats.set(seatId, { code: seatCode, type: seatType });
                    this.classList.add("seat-selected");
                }

                updateSelectedDisplay();
            });
        });

        // Click suggestion promo tag
        document.querySelectorAll(".promo-tag").forEach(tag => {
            tag.addEventListener("click", function () {
                promoInput.value = this.getAttribute("data-code");
                recalculatePrice();
            });
        });

        applyPromoBtn.addEventListener("click", function () {
            recalculatePrice();
        });

        promoInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                recalculatePrice();
            }
        });

        function updateSelectedDisplay() {
            container.innerHTML = "";
            const ids = Array.from(selectedSeats.keys());
            countText.innerText = ids.length;
            seatJsonInput.value = JSON.stringify(ids);

            if (ids.length === 0) {
                container.innerHTML = `<span class="text-secondary fs-8 fst-italic">Chưa có ghế nào được chọn.</span>`;
                priceText.innerText = "0 ₫";
                submitBtn.disabled = true;
                return;
            }

            selectedSeats.forEach((val, id) => {
                const badge = document.createElement("span");
                badge.className = `badge ${val.type === 'VIP' ? 'bg-danger' : 'bg-primary'} fs-8 d-inline-flex align-items-center gap-1`;
                badge.innerHTML = `${val.code} <i class="bi bi-x-circle cursor-pointer" onclick="deselectSeat(${id})"></i>`;
                container.appendChild(badge);
            });

            submitBtn.disabled = false;
            recalculatePrice();
        }

        window.deselectSeat = function (seatId) {
            const btn = document.querySelector(`.seat-btn[data-seat-id='${seatId}']`);
            if (btn) btn.classList.remove("seat-selected");
            selectedSeats.delete(seatId);
            updateSelectedDisplay();
        };

        async function recalculatePrice() {
            const ids = Array.from(selectedSeats.keys());
            if (ids.length === 0) {
                priceText.innerText = "0 ₫";
                promoFeedback.innerHTML = "";
                return;
            }

            const code = promoInput.value.trim().toUpperCase();
            promoFormInput.value = code;

            try {
                const resp = await fetch("/Bookings/CalculatePrice", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        showtimeId: showtimeId,
                        seatCount: ids.length,
                        promoCode: code || null
                    })
                });

                const res = await resp.json();
                if (res.success) {
                    priceText.innerText = res.formattedPrice;
                    if (code) {
                        promoFeedback.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>Áp dụng mã ${code} thành công!</span>`;
                    } else {
                        promoFeedback.innerHTML = "";
                    }
                } else {
                    promoFeedback.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>${res.message}</span>`;
                    // fallback to no promo calculation
                    if (code) {
                        fetch("/Bookings/CalculatePrice", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                showtimeId: showtimeId,
                                seatCount: ids.length,
                                promoCode: null
                            })
                        }).then(r => r.json()).then(fallback => {
                            if (fallback.success) priceText.innerText = fallback.formattedPrice;
                        });
                    }
                }
            } catch (err) {
                console.error("Error calculating price:", err);
            }
        }
    });
</script>
}
