@model CineSeat.Web.Models.SeatMapViewModel
@{
    ViewData["Title"] = $"Chọn Ghế - {Model.Movie.Title}";
}

<div class="container pb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb fs-8">
            <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-secondary text-decoration-none"><i class="bi bi-house me-1"></i>Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Showtime.MovieId" class="text-secondary text-decoration-none">@Model.Movie.Title</a></li>
            <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Chọn Ghế Suất @Model.Showtime.StartAt.ToString("HH:mm")</li>
        </ol>
    </nav>

    <!-- Header Thông tin Suất Chiếu -->
    <div class="card bg-card border-cs rounded-4 p-4 mb-4 shadow-sm">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge badge-rating badge-rating-@Model.Movie.AgeRating">@Model.Movie.AgeRating</span>
                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 fs-8">
                        <i class="bi bi-door-open me-1"></i>@Model.Showtime.RoomName
                    </span>
                    <span class="badge bg-dark border-cs text-gold fs-8">
                        <i class="bi bi-geo-alt me-1"></i>@Model.Showtime.CinemaName
                    </span>
                </div>
                <h3 class="fw-extrabold text-white mb-1">@Model.Movie.Title</h3>
                <div class="text-secondary fs-8">
                    <i class="bi bi-clock me-1 text-danger"></i>@Model.Showtime.StartAt.ToString("HH:mm") - @Model.Showtime.EndAt.ToString("HH:mm") &bull; 
                    <i class="bi bi-calendar3 me-1 text-gold"></i>@Model.Showtime.StartAt.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN")) &bull;
                    <span class="text-info">@((Model.Showtime.StartAt.Hour >= 18) ? "Suất tối (+20%)" : "Suất ngày chuẩn")</span>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="small text-secondary">Đơn giá vé cơ bản</div>
                <div class="fs-3 fw-extrabold text-gold">@Model.Showtime.BasePrice.ToString("#,##0") ₫</div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("ADMIN"))
    {
        <!-- CẢNH BÁO CHẾ ĐỘ XEM QUẢN TRỊ VIÊN -->
        <div class="alert alert-warning bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-4 p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-3 shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <span class="p-2 rounded-circle bg-warning bg-opacity-25 text-warning fs-4 d-flex align-items-center justify-content-center" style="width:44px; height:44px;">
                    <i class="bi bi-shield-lock-fill"></i>
                </span>
                <div>
                    <h6 class="fw-bold text-warning mb-0">Chế độ Xem Dành Cho Quản Trị Viên (Admin View)</h6>
                    <div class="text-light fs-8 mt-1">
                        Tài khoản Quản trị viên chỉ có quyền xem thông tin phim, suất chiếu và kiểm tra sơ đồ ghế. Tính năng đặt vé không áp dụng cho tài khoản Admin.
                    </div>
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Showtimes" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 fs-8 fw-semibold">
                <i class="bi bi-gear-fill me-1"></i> Quản lý suất chiếu
            </a>
        </div>
    }

    <!-- Sơ đồ ghế & Sticky Summary Card -->
    <div class="row g-4">
        <!-- VÙNG SƠ ĐỒ GHẾ (CINEMA SCREEN + 5x8 SEATS) -->
        <div class="col-lg-8">
            <div class="card bg-card border-cs rounded-4 p-4 shadow-sm text-center">
                <!-- 3D Curved Cinema Screen -->
                <div class="screen-stage">
                    <div class="curved-screen">
                        <span class="screen-label"><i class="bi bi-display me-2"></i>Màn Hình Chiếu Phim (Screen)</span>
                    </div>
                </div>

                <!-- Lưới 5 hàng A-E x 8 cột 1-8 -->
                <div class="seat-matrix">
                    @foreach (var row in Model.Rows)
                    {
                        <div class="seat-row">
                            <!-- Hàng Label Trái -->
                            <div class="seat-row-label">@row.Key</div>

                            <!-- 8 Ghế trong hàng -->
                            @foreach (var seat in row.Value)
                            {
                                string seatClass = "seat-box ";
                                bool isSelectable = seat.Status == "AVAILABLE";

                                if (seat.Status == "SOLD")
                                {
                                    seatClass += "seat-sold";
                                }
                                else if (seat.Status == "HELD")
                                {
                                    seatClass += "seat-held";
                                }
                                else
                                {
                                    seatClass += seat.SeatType == "VIP" ? "seat-available seat-vip" : "seat-available seat-standard";
                                }

                                <div class="@seatClass" 
                                     id="seat-btn-@seat.SeatId"
                                     data-seat-id="@seat.SeatId" 
                                     data-seat-code="@seat.SeatCode"
                                     data-seat-type="@seat.SeatType"
                                     data-status="@seat.Status"
                                     title="Ghế @seat.SeatCode (@seat.SeatType - @seat.Status)">
                                    @(seat.Status == "SOLD" ? "X" : seat.SeatNumber.ToString())
                                </div>
                            }

                            <!-- Hàng Label Phải -->
                            <div class="seat-row-label">@row.Key</div>
                        </div>
                    }
                </div>

                <!-- Chú thích loại ghế (Legend) -->
                <div class="d-flex flex-wrap justify-content-center gap-3 pt-4 border-top border-cs fs-8 text-secondary mt-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="seat-box seat-standard" style="width:24px; height:24px; font-size:10px;">1</span>
                        <span>Ghế Thường</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="seat-box seat-vip" style="width:24px; height:24px; font-size:10px;">1</span>
                        <span class="text-gold fw-semibold">Ghế VIP (Hàng D, E)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="seat-box seat-selected" style="width:24px; height:24px; font-size:10px;">✓</span>
                        <span class="text-white fw-bold">Đang chọn</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="seat-box seat-held" style="width:24px; height:24px; font-size:10px;">•</span>
                        <span class="text-warning">Đang giữ (HELD)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="seat-box seat-sold" style="width:24px; height:24px; font-size:10px;">X</span>
                        <span>Đã bán (SOLD)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG TÓM TẮT ĐẶT VÉ DÍNH (STICKY SUMMARY CARD) -->
        <div class="col-lg-4">
            <div class="sticky-summary">
                <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                    <span class="p-1 rounded-2 bg-danger bg-opacity-25 text-danger"><i class="bi bi-receipt-cutoff"></i></span>
                    Thông Tin Đặt Vé
                </h5>

                <!-- Khách hàng đang thao tác -->
                @if (User.IsInRole("ADMIN"))
                {
                    <div class="p-2 mb-3 bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-3 d-flex align-items-center gap-2">
                        <span class="user-avatar-circle bg-warning text-dark fw-bold" style="width:28px; height:28px; font-size:0.75rem;"><i class="bi bi-shield-lock-fill"></i></span>
                        <div class="text-truncate">
                            <div class="text-white small fw-bold lh-1 text-truncate">@Model.CurrentUserName</div>
                            <small class="text-warning fs-9"><i class="bi bi-shield-check me-1"></i>Quản Trị Viên (Không đặt vé)</small>
                        </div>
                    </div>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="p-2 mb-3 bg-surface rounded-3 border-cs d-flex align-items-center gap-2">
                        <span class="user-avatar-circle" style="width:28px; height:28px; font-size:0.75rem;">@(string.IsNullOrEmpty(Model.CurrentUserName) ? "U" : Model.CurrentUserName.Substring(0, 1).ToUpper())</span>
                        <div class="text-truncate">
                            <div class="text-white small fw-bold lh-1 text-truncate">@Model.CurrentUserName</div>
                            <small class="text-success fs-9"><i class="bi bi-patch-check-fill me-1"></i>Đã đăng nhập (Mã KH: #@Model.CurrentUserId)</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-2 mb-3 bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-exclamation text-danger fs-5"></i>
                            <div>
                                <div class="text-white small fw-bold">Khách vãng lai</div>
                                <small class="text-secondary fs-9">Cần đăng nhập để giữ ghế</small>
                            </div>
                        </div>
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-outline-danger py-0 px-2 fs-9">Đăng nhập</a>
                    </div>
                }

                <!-- Danh sách ghế đang chọn -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center small text-secondary mb-2">
                        <span>Ghế đã chọn:</span>
                        <span class="fw-bold text-white"><span id="seatCountText">0</span>/8 ghế</span>
                    </div>
                    <div id="selectedSeatsContainer" class="p-2 bg-surface rounded-3 border-cs d-flex flex-wrap gap-1 min-vh-25">
                        <span class="text-secondary fs-8 fst-italic p-1">Chưa có ghế nào được chọn.</span>
                    </div>
                </div>

                <!-- Nhập Mã Khuyến Mãi -->
                <div class="mb-3">
                    <label class="form-label fs-8 text-secondary fw-semibold">Mã khuyến mãi (Promotions):</label>
                    <div class="input-group input-group-sm mb-1">
                        <input type="text" id="promoCodeInput" class="form-control bg-surface border-cs text-white text-uppercase shadow-none" placeholder="Nhập mã (VD: SALE10)" />
                        <button type="button" id="applyPromoBtn" class="btn btn-cinema-gold">Áp dụng</button>
                    </div>
                    <div id="promoFeedback" class="fs-8 mt-1"></div>

                    <!-- Gợi ý mã khuyến mãi từ Oracle -->
                    <div class="mt-2">
                        <small class="text-secondary fs-9 d-block mb-1">Mã khuyến mãi có hiệu lực:</small>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var p in Model.AvailablePromotions)
                            {
                                <span class="promo-badge-tag promo-tag" data-code="@p.PromoCode" title="Giảm @p.DiscountPct%">
                                    @p.PromoCode (-@p.DiscountPct%)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Tạm tính tiền từ PL/SQL PKG_BOOKING.FN_TOTAL_PRICE -->
                <div class="p-3 bg-surface rounded-3 border-cs mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                        <span>Đơn giá cơ bản:</span>
                        <span>@Model.Showtime.BasePrice.ToString("#,##0") ₫ / vé</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                        <span>Phụ thu khung giờ:</span>
                        <span class="@(Model.Showtime.StartAt.Hour >= 18 ? "text-warning fw-semibold" : "")">
                            @(Model.Showtime.StartAt.Hour >= 18 ? "+20% (Suất tối ≥ 18h)" : "0%")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-1 fs-8 text-secondary">
                        <span>Phụ thu ngày chiếu:</span>
                        <span class="@((Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Saturday || Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Sunday) ? "text-warning fw-semibold" : "")">
                            @((Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Saturday || Model.Showtime.StartAt.DayOfWeek == DayOfWeek.Sunday) ? "+10% (Cuối tuần T7/CN)" : "0%")
                        </span>
                    </div>
                    <div id="discountRow" class="d-flex justify-content-between align-items-center mb-1 fs-8 text-success d-none">
                        <span>Giảm giá khuyến mãi:</span>
                        <span id="discountText">-0 ₫</span>
                    </div>
                    <hr class="border-cs my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white fs-7">Tổng tạm tính:</span>
                        <span id="totalPriceText" class="fs-4 fw-extrabold text-gold">0 ₫</span>
                    </div>
                </div>

                <!-- Nút Tiến hành giữ ghế -->
                <form id="holdSeatsForm" asp-controller="Bookings" asp-action="Hold" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ShowtimeId" value="@Model.Showtime.ShowtimeId" />
                    <input type="hidden" id="seatIdsJsonInput" name="SeatIdsJson" value="[]" />
                    <input type="hidden" id="promoCodeFormInput" name="PromoCode" value="" />

                    @if (User.IsInRole("ADMIN"))
                    {
                        <button type="button" id="submitHoldBtn" class="btn btn-secondary w-100 fw-bold py-3 rounded-pill d-flex align-items-center justify-content-center gap-2 opacity-75" disabled>
                            <i class="bi bi-slash-circle-fill"></i>
                            <span>Admin Không Thể Đặt Vé</span>
                        </button>
                    }
                    else
                    {
                        <button type="submit" id="submitHoldBtn" class="btn btn-cinema w-100 fw-bold py-3 rounded-pill d-flex align-items-center justify-content-center gap-2" disabled>
                            <i class="bi bi-lock-fill"></i>
                            <span>Tiến Hành Giữ Ghế (5 Phút)</span>
                        </button>
                    }
                </form>

                <div class="text-center mt-3">
                    @if (User.IsInRole("ADMIN"))
                    {
                        <small class="text-warning fs-9">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Tài khoản Quản trị viên chỉ có quyền xem phim và sơ đồ ghế, không thể đặt vé.
                        </small>
                    }
                    else
                    {
                        <small class="text-secondary fs-9">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Hệ thống tự động khóa giữ ghế an toàn trong 5 phút để bạn hoàn tất thanh toán.
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TOAST CẢNH BÁO TRANH CHẤP TRANH GHẾ -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090">
    <div id="conflictToast" class="toast align-items-center text-white bg-danger border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                <div>
                    <strong class="d-block">Ghế đã có người đặt trước!</strong>
                    <span id="conflictToastMessage">Ghế bạn chọn vừa có khách hàng khác đặt trước, hệ thống đã cập nhật lại sơ đồ ghế.</span>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const isAdmin = @(User.IsInRole("ADMIN") ? "true" : "false");
        const selectedSeats = new Map(); // seatId -> { code, type }
        const maxSeats = 8;
        const showtimeId = @Model.Showtime.ShowtimeId;

        const seatBtns = document.querySelectorAll(".seat-available");
        const container = document.getElementById("selectedSeatsContainer");
        const countText = document.getElementById("seatCountText");
        const priceText = document.getElementById("totalPriceText");
        const submitBtn = document.getElementById("submitHoldBtn");
        const seatJsonInput = document.getElementById("seatIdsJsonInput");
        const promoInput = document.getElementById("promoCodeInput");
        const promoFormInput = document.getElementById("promoCodeFormInput");
        const applyPromoBtn = document.getElementById("applyPromoBtn");
        const promoFeedback = document.getElementById("promoFeedback");
        const holdForm = document.getElementById("holdSeatsForm");

        // Chọn / Bỏ chọn ghế
        seatBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const seatId = parseInt(this.getAttribute("data-seat-id"));
                const seatCode = this.getAttribute("data-seat-code");
                const seatType = this.getAttribute("data-seat-type");

                if (selectedSeats.has(seatId)) {
                    selectedSeats.delete(seatId);
                    this.classList.remove("seat-selected");
                } else {
                    if (selectedSeats.size >= maxSeats) {
                        alert("Mỗi đơn hàng chỉ được phép chọn tối đa 8 ghế!");
                        return;
                    }
                    selectedSeats.set(seatId, { code: seatCode, type: seatType });
                    this.classList.add("seat-selected");
                }

                updateSelectedDisplay();
            });
        });

        // Click vào tag mã khuyến mãi gợi ý
        document.querySelectorAll(".promo-tag").forEach(tag => {
            tag.addEventListener("click", function () {
                promoInput.value = this.getAttribute("data-code");
                calculatePrice();
            });
        });

        // Nút bấm áp dụng mã
        applyPromoBtn.addEventListener("click", function () {
            calculatePrice();
        });

        promoInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                calculatePrice();
            }
        });

        function updateSelectedDisplay() {
            container.innerHTML = "";
            const seatIds = Array.from(selectedSeats.keys());
            seatJsonInput.value = JSON.stringify(seatIds);
            countText.textContent = selectedSeats.size;

            if (selectedSeats.size === 0) {
                container.innerHTML = '<span class="text-secondary fs-8 fst-italic p-1">Chưa có ghế nào được chọn.</span>';
                priceText.textContent = "0 ₫";
                submitBtn.disabled = true;
                return;
            }

            if (isAdmin) {
                if (submitBtn) submitBtn.disabled = true;
            } else {
                if (submitBtn) submitBtn.disabled = false;
            }

            selectedSeats.forEach((seatInfo, id) => {
                const badge = document.createElement("span");
                badge.className = "badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 p-2 fs-8 d-inline-flex align-items-center gap-1";
                badge.innerHTML = `<i class="bi bi-ticket me-1"></i>${seatInfo.code} <span class="badge ${seatInfo.type === 'VIP' ? 'bg-warning text-dark' : 'bg-secondary'} fs-9">${seatInfo.type}</span>`;
                container.appendChild(badge);
            });

            calculatePrice();
        }

        // Gọi AJAX tính giá từ PKG_BOOKING.FN_TOTAL_PRICE
        async function calculatePrice() {
            if (selectedSeats.size === 0) {
                priceText.textContent = "0 ₫";
                return;
            }

            const code = promoInput.value.trim().toUpperCase();
            promoFormInput.value = code;

            priceText.innerHTML = '<span class="spinner-border spinner-border-sm text-gold"></span>';
            promoFeedback.innerHTML = "";

            try {
                const res = await fetch("/Bookings/CalculatePrice", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        showtimeId: showtimeId,
                        seatCount: selectedSeats.size,
                        promoCode: code || null
                    })
                });

                const data = await res.json();
                if (data.success) {
                    priceText.textContent = data.formattedPrice;
                    if (code) {
                        promoFeedback.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Mã [${code}] hợp lệ! Đã áp dụng giảm giá.</span>`;
                    }
                } else {
                    priceText.textContent = "---";
                    promoFeedback.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                priceText.textContent = "---";
                promoFeedback.innerHTML = `<span class="text-danger"><i class="bi bi-wifi-off me-1"></i>Không thể kết nối đến máy chủ.</span>`;
            }
        }

        // Xử lý gửi giữ ghế (AJAX Hold để bắt lỗi ORA-20005 và auto refresh)
        holdForm.addEventListener("submit", async function (e) {
            e.preventDefault();

            if (isAdmin) {
                alert("Tài khoản Quản trị viên (Admin) không được phép thực hiện đặt vé!");
                return;
            }

            const seatIds = Array.from(selectedSeats.keys());
            if (seatIds.length === 0) {
                alert("Vui lòng chọn ít nhất 1 ghế!");
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý giữ ghế trong Oracle 23ai...';

            try {
                const res = await fetch("/Bookings/HoldJson", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        showtimeId: showtimeId,
                        seatIdsJson: JSON.stringify(seatIds),
                        promoCode: promoInput.value.trim().toUpperCase() || null
                    })
                });

                const data = await res.json();
                if (data.success) {
                    window.location.href = `/Bookings/Checkout/${data.bookingId}`;
                } else {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-lock-fill"></i> Tiến Hành Giữ Ghế (5 Phút)';

                    if (data.errorCode === 20005) {
                        // Lỗi tranh chấp ghế ORA-20005
                        const toastEl = document.getElementById("conflictToast");
                        document.getElementById("conflictToastMessage").textContent = data.errorMessage;
                        const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                        toast.show();

                        // Tự động làm mới trang sau 1.5 giây để load sơ đồ ghế mới nhất
                        setTimeout(() => {
                            window.location.reload();
                        }, 1800);
                    } else {
                        alert(data.errorMessage);
                    }
                }
            } catch (err) {
                // Fallback submit form thông thường nếu Fetch lỗi mạng
                holdForm.submit();
            }
        });
    });
</script>
}
