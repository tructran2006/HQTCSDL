@model CineSeat.Web.Models.CheckoutViewModel
@{
    ViewData["Title"] = $"Thanh Toán Đơn #{Model.Booking.BookingId}";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-warning text-decoration-none">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Bookings" asp-action="History" class="text-warning text-decoration-none">Lịch Sử Đặt Vé</a></li>
        <li class="breadcrumb-item active text-secondary" aria-current="page">Thanh Toán Đơn #@Model.Booking.BookingId</li>
    </ol>
</nav>

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <!-- Countdown Timer Banner -->
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 text-center mb-4 shadow">
            <h5 class="text-secondary mb-2 text-uppercase fs-8 tracking-wider">Thời Gian Giữ Chỗ Còn Lại</h5>
            <div id="countdownBox" class="countdown-box @(Model.RemainingSeconds <= 60 ? "urgent" : "")">
                <span id="countdownMinutes">--</span>:<span id="countdownSeconds">--</span>
            </div>
            <div class="mt-2 text-secondary fs-8">
                <i class="bi bi-info-circle me-1"></i> Sau 5 phút, thủ tục <code>PR_EXPIRE_HOLDS</code> sẽ tự động hủy đơn và thu hồi ghế.
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 mb-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                <h5 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-ticket-detailed text-warning"></i> Chi Tiết Đơn Đặt Vé #@Model.Booking.BookingId
                </h5>
                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50">
                    Trạng thái: @Model.Booking.Status
                </span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <small class="text-secondary d-block">Phim:</small>
                    <span class="fw-bold text-white fs-5">@Model.Booking.MovieTitle</span>
                </div>
                <div class="col-md-6">
                    <small class="text-secondary d-block">Khách hàng:</small>
                    <span class="fw-semibold text-light">@Model.Booking.FullName</span>
                </div>
                <div class="col-md-6">
                    <small class="text-secondary d-block">Cụm rạp & Phòng:</small>
                    <span class="text-light">@Model.Booking.CinemaName - @Model.Booking.RoomName</span>
                </div>
                <div class="col-md-6">
                    <small class="text-secondary d-block">Suất chiếu:</small>
                    <span class="text-warning fw-semibold">
                        @(Model.Booking.StartAt.HasValue ? Model.Booking.StartAt.Value.ToString("HH:mm - dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN")) : "")
                    </span>
                </div>
                <div class="col-12">
                    <small class="text-secondary d-block mb-1">Ghế đã giữ:</small>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var s in Model.Booking.Seats)
                        {
                            <span class="badge @(s.SeatType == "VIP" ? "bg-danger" : "bg-primary") px-3 py-2 fs-7">
                                Ghế @s.SeatCode (@s.SeatType) - @s.UnitPrice.ToString("#,##0") ₫
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="p-3 bg-dark rounded-3 d-flex justify-content-between align-items-center">
                <span class="fs-5 fw-bold text-white">Tổng tiền cần thanh toán:</span>
                <span class="fs-3 fw-bold text-warning">@Model.Booking.TotalAmount.ToString("#,##0") ₫</span>
            </div>
        </div>

        <!-- Payment Method Selection -->
        <div class="card bg-black border-secondary border-opacity-25 rounded-4 p-4 shadow-sm mb-4">
            <h5 class="fw-bold text-white mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-wallet2 text-warning"></i> Phương Thức Thanh Toán Mô Phỏng (DEMO)
            </h5>

            <form asp-controller="Bookings" asp-action="ConfirmPayment" method="post" id="paymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Booking.BookingId" />

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="card h-100 p-3 bg-dark border-secondary border-opacity-50 rounded-3 cursor-pointer payment-option-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="radio" name="method" value="DEMO_QR" checked class="form-check-input mt-0" />
                                <span class="fw-bold text-white">DEMO_QR</span>
                            </div>
                            <small class="text-secondary fs-8">Mô phỏng quét mã VietQR ngân hàng.</small>
                            <div class="mt-2 text-center text-warning fs-3">
                                <i class="bi bi-qr-code"></i>
                            </div>
                        </label>
                    </div>

                    <div class="col-md-4">
                        <label class="card h-100 p-3 bg-dark border-secondary border-opacity-50 rounded-3 cursor-pointer payment-option-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="radio" name="method" value="DEMO_CARD" class="form-check-input mt-0" />
                                <span class="fw-bold text-white">DEMO_CARD</span>
                            </div>
                            <small class="text-secondary fs-8">Mô phỏng thẻ tín dụng / ghi nợ quốc tế.</small>
                            <div class="mt-2 text-center text-info fs-3">
                                <i class="bi bi-credit-card-2-front"></i>
                            </div>
                        </label>
                    </div>

                    <div class="col-md-4">
                        <label class="card h-100 p-3 bg-dark border-secondary border-opacity-50 rounded-3 cursor-pointer payment-option-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input type="radio" name="method" value="DEMO_CASH" class="form-check-input mt-0" />
                                <span class="fw-bold text-white">DEMO_CASH</span>
                            </div>
                            <small class="text-secondary fs-8">Mô phỏng thanh toán tiền mặt tại quầy vé.</small>
                            <div class="mt-2 text-center text-success fs-3">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <button type="submit" id="btnConfirmPay" class="btn btn-warning fw-bold py-3 flex-grow-1 shadow d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Xác Nhận Thanh Toán Ngay
                    </button>
                </div>
            </form>

            <!-- Cancel Button -->
            <form asp-controller="Bookings" asp-action="CancelBooking" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Booking.BookingId" />
                <button type="submit" class="btn btn-outline-danger w-100 fw-semibold" 
                        onclick="return confirm('Bạn có chắc chắn muốn hủy giữ ghế cho đơn hàng này? Ghế sẽ lập tức được trả về trạng thái AVAILABLE.')">
                    <i class="bi bi-x-circle me-1"></i> Hủy Giữ Ghế (Hoàn Ghế Trống)
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let remainingSeconds = @Model.RemainingSeconds;
        const minutesSpan = document.getElementById("countdownMinutes");
        const secondsSpan = document.getElementById("countdownSeconds");
        const countdownBox = document.getElementById("countdownBox");
        const payBtn = document.getElementById("btnConfirmPay");

        function updateTimer() {
            if (remainingSeconds <= 0) {
                minutesSpan.innerText = "00";
                secondsSpan.innerText = "00";
                countdownBox.classList.add("urgent");
                payBtn.disabled = true;
                payBtn.innerHTML = `<i class="bi bi-clock-history"></i> Đã Hết 5 Phút Giữ Ghế`;
                return;
            }

            const m = Math.floor(remainingSeconds / 60);
            const s = remainingSeconds % 60;

            minutesSpan.innerText = m.toString().padStart(2, "0");
            secondsSpan.innerText = s.toString().padStart(2, "0");

            if (remainingSeconds <= 60) {
                countdownBox.classList.add("urgent");
            }

            remainingSeconds--;
            setTimeout(updateTimer, 1000);
        }

        updateTimer();
    });
</script>
}
