@model CineSeat.Web.Models.Booking
@{
    ViewData["Title"] = $"Vé Điện Tử #{Model.BookingId} - CineSeat";
    var showtime = ViewBag.Showtime as CineSeat.Web.Models.Showtime;
    var movie = ViewBag.Movie as CineSeat.Web.Models.Movie;
}

<div class="container pb-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4 d-print-none">
        <ol class="breadcrumb fs-8">
            <li class="breadcrumb-item"><a asp-controller="Movies" asp-action="Index" class="text-secondary text-decoration-none">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="History" class="text-secondary text-decoration-none">Lịch Sử Đặt Vé</a></li>
            <li class="breadcrumb-item active text-danger fw-bold" aria-current="page">Vé Điện Tử #@Model.BookingId</li>
        </ol>
    </nav>

    <!-- ACTIONS BAR -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none" style="max-width: 540px; margin: 0 auto;">
        <a asp-action="History" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại lịch sử
        </a>
        <button type="button" onclick="window.print()" class="btn btn-outline-light btn-sm rounded-pill px-3">
            <i class="bi bi-printer me-1"></i> In Vé / Lưu PDF
        </button>
    </div>

    <!-- DIGITAL E-TICKET VOUCHER -->
    <div class="ticket-wrapper">
        <!-- Top Banner Header -->
        <div class="p-4 bg-surface border-bottom border-cs text-center">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold text-white fs-6">Cine<span class="text-danger">Seat</span> Cinema</span>
                
                @if (Model.Status == "PAID")
                {
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 fs-9">
                        <i class="bi bi-check-circle-fill me-1"></i>VÉ HỢP LỆ (PAID)
                    </span>
                }
                else if (Model.Status == "HELD")
                {
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 fs-9">
                        ĐANG GIỮ GHẾ (HELD)
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-50 fs-9">
                        @Model.Status
                    </span>
                }
            </div>

            <h4 class="fw-extrabold text-white mb-1">@Model.MovieTitle</h4>
            <div class="text-secondary fs-8">
                <i class="bi bi-geo-alt text-danger me-1"></i>@Model.CinemaName • @Model.RoomName
            </div>
        </div>

        <!-- Ticket Body Details -->
        <div class="p-4">
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <small class="text-secondary fs-9 d-block">Mã đơn đặt vé</small>
                    <span class="fw-bold text-white fs-6">#@Model.BookingId</span>
                </div>
                <div class="col-6 text-end">
                    <small class="text-secondary fs-9 d-block">Khách hàng</small>
                    <span class="fw-bold text-white fs-7">@Model.FullName</span>
                </div>
                <div class="col-6">
                    <small class="text-secondary fs-9 d-block">Giờ bắt đầu chiếu</small>
                    <span class="fw-bold text-gold fs-5">@Model.StartAt?.ToString("HH:mm")</span>
                    <small class="text-secondary fs-9 d-block">@Model.StartAt?.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="col-6 text-end">
                    <small class="text-secondary fs-9 d-block">Số lượng vé</small>
                    <span class="badge bg-danger rounded-pill fs-8">@Model.Seats.Count vé</span>
                </div>
            </div>

            <!-- Ghế chi tiết -->
            <div class="p-3 bg-surface rounded-3 border-cs mb-3">
                <small class="text-secondary fs-9 d-block mb-1">Ghế đã mua:</small>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var s in Model.Seats)
                    {
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 p-2 fs-8">
                            <i class="bi bi-ticket me-1"></i>@s.SeatCode (@s.SeatType) - @s.UnitPrice.ToString("#,##0") ₫
                        </span>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-cs">
                <span class="text-secondary fw-semibold">Tổng thanh toán:</span>
                <span class="fs-3 fw-extrabold text-gold">@Model.TotalAmount.ToString("#,##0") ₫</span>
            </div>

            @if (Model.PaidAt.HasValue)
            {
                <div class="text-secondary fs-9 text-end mt-1">
                    Thời điểm thanh toán: @Model.PaidAt.Value.ToString("HH:mm:ss dd/MM/yyyy")
                </div>
            }
        </div>

        <!-- Perforation -->
        <div class="ticket-perforation">
            <div class="ticket-notch-left"></div>
            <div class="ticket-dash"></div>
            <div class="ticket-notch-right"></div>
        </div>

        <!-- QR Code Ticket Verification -->
        <div class="p-4 pt-2 text-center bg-surface">
            <div class="p-3 bg-white rounded-3 d-inline-block shadow mb-2">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=CINESEAT-TICKET-@Model.BookingId-@Model.UserId-@Model.TotalAmount" 
                     alt="E-Ticket QR" width="120" height="120"
                     onerror="this.onerror=null; this.src='/images/default-poster.jpg';" />
            </div>
            <div class="text-white fw-bold fs-7 tracking-wider">MÃ VÉ: CS-@Model.BookingId-@Model.ShowtimeId</div>
            <div class="text-secondary fs-9">Xuất trình mã QR này tại quầy soát vé rạp chiếu phim để vào phòng chiếu.</div>
        </div>
    </div>
</div>
