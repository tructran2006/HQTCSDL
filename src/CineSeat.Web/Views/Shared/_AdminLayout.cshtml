@inject CineSeat.Web.Services.IUserContext UserContext
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineSeat Admin Portal</title>
    <!-- Google Fonts: Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- CineSeat Custom Modern CSS -->
    <link rel="stylesheet" href="~/css/cineseat.css" asp-append-version="true" />
</head>
<body class="bg-dark">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar shadow-lg">
        <!-- Logo & Branding -->
        <div class="p-3 border-bottom border-cs">
            <a asp-controller="Admin" asp-action="Dashboard" class="d-flex align-items-center gap-2 text-decoration-none">
                <span class="p-2 rounded-3 bg-danger text-white d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </span>
                <div>
                    <div class="fw-bold fs-5 text-white lh-1">Cine<span class="text-danger">Seat</span></div>
                    <small class="text-secondary fs-9 text-uppercase tracking-wider">Admin Portal 23ai</small>
                </div>
            </a>
        </div>

        <!-- Navigation Menu -->
        <div class="py-3 flex-grow-1">
            <div class="px-3 mb-2 text-uppercase fs-9 fw-bold text-secondary">Quản Trị Nghiệp Vụ</div>
            
            <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
               asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2 text-danger fs-5"></i>
                <span>Tổng quan Dashboard</span>
            </a>

            <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Movies" ? "active" : "")" 
               asp-controller="Admin" asp-action="Movies">
                <i class="bi bi-film text-warning fs-5"></i>
                <span>Quản lý Phim</span>
            </a>

            <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Showtimes" ? "active" : "")" 
               asp-controller="Admin" asp-action="Showtimes">
                <i class="bi bi-calendar3 text-info fs-5"></i>
                <span>Quản lý Suất chiếu</span>
            </a>

            <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Bookings" ? "active" : "")" 
               asp-controller="Admin" asp-action="Bookings">
                <i class="bi bi-ticket-detailed text-success fs-5"></i>
                <span>Quản lý Đơn đặt vé</span>
            </a>

            <hr class="border-cs mx-3 my-3">

            <!-- Phím tắt chạy PR_EXPIRE_HOLDS -->
            <div class="px-3">
                <form asp-controller="Admin" asp-action="TriggerExpire" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <button type="submit" class="btn btn-outline-warning w-100 btn-sm rounded-3 py-2 d-flex align-items-center justify-content-center gap-2 fw-semibold">
                        <i class="bi bi-hourglass-bottom"></i>
                        <span>Quét thu hồi ghế</span>
                    </button>
                    <div class="text-secondary fs-9 mt-1 text-center">Gọi thủ tục PR_EXPIRE_HOLDS</div>
                </form>
            </div>
        </div>

        <!-- Sidebar Footer: Back to Customer portal -->
        <div class="p-3 border-top border-cs bg-surface">
            <a asp-controller="Movies" asp-action="Index" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-2 rounded-pill">
                <i class="bi bi-arrow-left"></i>
                <span>Cổng Khách Hàng</span>
            </a>
            <div class="text-center mt-2 fs-9 text-secondary">
                Schema: <span class="text-gold fw-bold">CINESEAT</span>@@FREEPDB1
            </div>
        </div>
    </aside>

    <!-- Admin Main Body -->
    <div class="admin-main">
        <!-- Top Navigation Bar for Admin -->
        <header class="navbar navbar-expand navbar-cineseat px-4 py-2 border-bottom border-cs sticky-top">
            <div class="container-fluid p-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 text-white">
                    <span class="badge bg-warning text-dark text-uppercase fs-9 fw-bold">ADMIN PORTAL</span>
                    <span class="text-secondary">/</span>
                    <span class="fw-semibold">@ViewData["Title"]</span>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 fs-9 d-flex align-items-center gap-1">
                        <span class="spinner-grow spinner-grow-sm" role="status" style="width: 8px; height: 8px;"></span>
                        <span>Oracle 23ai: ONLINE</span>
                    </span>

                    <div class="d-flex align-items-center gap-2 border-start border-cs ps-3">
                        <span class="user-avatar-circle" style="background: linear-gradient(135deg, #F5C518, #E50914);">A</span>
                        <div class="d-none d-md-block text-start">
                            <div class="small fw-bold text-white lh-1">@UserContext.CurrentUserName</div>
                            <small class="text-gold fs-9">Quản trị viên</small>
                        </div>
                    </div>

                    <a asp-controller="Movies" asp-action="Index" class="btn btn-sm btn-outline-light rounded-pill px-3 fs-8">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Web Khách
                    </a>

                    <!-- Nút Đăng Xuất Admin -->
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fs-8 d-flex align-items-center gap-1">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Đăng Xuất</span>
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <!-- Alerts -->
        <div class="container-fluid px-4 pt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 border-0 shadow-lg bg-success bg-opacity-25 text-white" role="alert">
                    <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                    <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-3 border-0 shadow-lg bg-danger bg-opacity-25 text-white" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                    <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        <!-- Page Content -->
        <main class="flex-grow-1 px-4 py-3">
            @RenderBody()
        </main>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
