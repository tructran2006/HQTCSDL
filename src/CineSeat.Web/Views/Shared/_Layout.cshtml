@inject CineSeat.Web.Services.IUserContext UserContext
@inject CineSeat.Web.Services.ICineSeatService CineSeatService
@{
    var currentUser = await UserContext.GetCurrentUserAsync();
    var allUsers = await CineSeatService.GetUsersAsync();
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineSeat | Đặt Vé Xem Phim</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">
    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-black bg-opacity-75 backdrop-blur border-bottom border-secondary border-opacity-25 py-2">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 fs-4 text-warning" asp-controller="Movies" asp-action="Index">
                    <i class="bi bi-film fs-3 text-warning"></i>
                    <span>Cine<span class="text-white">Seat</span></span>
                    <span class="badge bg-danger text-uppercase ms-1 fs-9 tracking-wider">Oracle 23ai</span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movies" ? "active text-warning fw-semibold" : "")" 
                               asp-controller="Movies" asp-action="Index">
                                <i class="bi bi-camera-reels me-1"></i> Phim Đang Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active text-warning fw-semibold" : "")" 
                               asp-controller="Bookings" asp-action="History">
                                <i class="bi bi-clock-history me-1"></i> Lịch Sử Đặt Vé
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active text-warning fw-semibold" : "")" 
                               asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard & Audit
                            </a>
                        </li>
                    </ul>

                    <!-- Demo User Switcher -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2 text-start rounded-pill px-3 py-1 bg-dark bg-opacity-50" 
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar-circle bg-warning text-dark fw-bold">@currentUser.FullName.Substring(0, 1)</span>
                                <div>
                                    <div class="small fw-semibold text-white lh-1">@currentUser.FullName</div>
                                    <small class="text-secondary fs-8">Khách hàng demo (ID: @currentUser.UserId)</small>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-secondary border-opacity-50 p-2" style="min-width: 280px; max-height: 360px; overflow-y: auto;">
                                <li class="dropdown-header text-uppercase fs-8 fw-bold text-warning">
                                    <i class="bi bi-people me-1"></i> Chọn tài khoản mô phỏng
                                </li>
                                @foreach (var u in allUsers)
                                {
                                    <li>
                                        <form asp-controller="Movies" asp-action="SwitchUser" method="post" class="d-inline w-100">
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between rounded py-2 @(u.UserId == currentUser.UserId ? "bg-warning text-dark fw-bold" : "")">
                                                <div>
                                                    <div>@u.FullName</div>
                                                    <small class="@(u.UserId == currentUser.UserId ? "text-dark opacity-75" : "text-secondary") fs-8">@u.Email</small>
                                                </div>
                                                @if (u.UserId == currentUser.UserId)
                                                {
                                                    <i class="bi bi-check-circle-fill text-dark ms-2"></i>
                                                }
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alerts / TempData -->
    <div class="container pt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-3 border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-3 border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-3 bg-black border-top border-secondary border-opacity-25">
        <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between small text-secondary gap-2">
            <div>
                <span class="fw-bold text-white">CineSeat</span> &copy; 2026 - Đề tài 06: Hệ Quản Trị Cơ Sở Dữ Liệu (HUFLIT)
            </div>
            <div class="d-flex align-items-center gap-3">
                <span><i class="bi bi-database me-1 text-warning"></i> Oracle 23ai Free (Docker)</span>
                <span><i class="bi bi-code-slash me-1 text-info"></i> ASP.NET Core 8 (.NET 8)</span>
                <span><i class="bi bi-shield-check me-1 text-success"></i> PL/SQL PKG_BOOKING</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
