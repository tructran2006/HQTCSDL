@model CineSeat.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản - CineSeat";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 col-xl-5">
            <!-- Card Đăng nhập -->
            <div class="card bg-card border-cs rounded-4 p-4 p-md-5 shadow-lg position-relative overflow-hidden">
                <!-- Vầng hào quang trang trí -->
                <div class="position-absolute top-0 start-50 translate-middle-x" 
                     style="width: 250px; height: 120px; background: radial-gradient(ellipse, rgba(229, 9, 20, 0.25) 0%, transparent 70%); filter: blur(25px); pointer-events: none;"></div>

                <div class="text-center mb-4 position-relative z-1">
                    <a asp-controller="Movies" asp-action="Index" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
                        <div class="brand-badge shadow-sm"><i class="bi bi-film"></i></div>
                        <span class="fs-4 fw-extrabold text-white tracking-wider">CINE<span class="text-danger">SEAT</span></span>
                    </a>
                    <h4 class="fw-bold text-white mb-1">Đăng Nhập Hệ Thống</h4>
                    <p class="text-secondary small">Trải nghiệm đặt vé trực tuyến & quản lý điện ảnh</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger rounded-3 fs-8 p-3 mb-4">
                        <div class="d-flex align-items-center gap-2 mb-1 fw-bold">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Thông báo đăng nhập:</span>
                        </div>
                        <div asp-validation-summary="All" class="mb-0 ps-3"></div>
                    </div>
                }

                <form asp-action="Login" method="post" id="loginForm" class="position-relative z-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-white fs-8 fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-surface border-cs text-secondary"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control bg-surface border-cs text-white shadow-none" 
                                   placeholder="VD: minhanh@demo.local hoặc admin@cineseat.vn" id="inputEmail" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger fs-9 mt-1 d-block"></span>
                    </div>

                    <!-- Mật khẩu / SĐT -->
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label text-white fs-8 fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-surface border-cs text-secondary"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control bg-surface border-cs text-white shadow-none" 
                                   placeholder="Nhập số điện thoại hoặc mật khẩu" id="inputPassword" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger fs-9 mt-1 d-block"></span>
                        <small class="text-secondary fs-9 mt-1 d-block">
                            * Với tài khoản Khách hàng demo, bạn có thể dùng SĐT trong DB hoặc mật khẩu <code>123456</code>.
                        </small>
                    </div>

                    <!-- Nút Đăng nhập chính -->
                    <button type="submit" class="btn btn-cinema w-100 rounded-pill py-2 fw-bold fs-7 shadow mb-4 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right fs-6"></i>
                        <span>Đăng Nhập</span>
                    </button>

                    <!-- Khung Phím Tắt Demo Thuận Tiện Khi Bảo Vệ Đồ Án -->
                    <div class="p-3 bg-surface rounded-3 border-cs mb-4">
                        <div class="fw-bold fs-9 text-gold text-uppercase mb-2 d-flex align-items-center gap-1">
                            <i class="bi bi-lightning-charge-fill"></i>
                            <span>Phím tắt điền nhanh tài khoản Demo (Bảo vệ đồ án):</span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger text-start d-flex justify-content-between align-items-center rounded-2 py-2 px-3" 
                                    onclick="fillCredentials('minhanh@demo.local', '0900000001')">
                                <div>
                                    <div class="fw-bold fs-8 text-white"><i class="bi bi-person-fill me-1"></i>Khách Hàng (Demo User 1)</div>
                                    <small class="text-secondary fs-9">minhanh@demo.local • SĐT: 0900000001</small>
                                </div>
                                <span class="badge bg-danger rounded-pill fs-9">Điền ngay</span>
                            </button>

                            <button type="button" class="btn btn-sm btn-outline-warning text-start d-flex justify-content-between align-items-center rounded-2 py-2 px-3" 
                                    onclick="fillCredentials('admin@cineseat.vn', 'Admin@123')">
                                <div>
                                    <div class="fw-bold fs-8 text-gold"><i class="bi bi-shield-lock-fill me-1"></i>Quản Trị Viên (Admin)</div>
                                    <small class="text-secondary fs-9">admin@cineseat.vn • Mật khẩu: Admin@123</small>
                                </div>
                                <span class="badge bg-warning text-dark rounded-pill fs-9 fw-bold">Điền ngay</span>
                            </button>
                        </div>
                    </div>

                    <!-- Link Đăng ký -->
                    <div class="text-center text-secondary fs-8">
                        Chưa có tài khoản? 
                        <a asp-action="Register" class="text-danger fw-bold text-decoration-none ms-1">Đăng ký thành viên mới</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, password) {
            document.getElementById('inputEmail').value = email;
            document.getElementById('inputPassword').value = password;
        }
    </script>
}
